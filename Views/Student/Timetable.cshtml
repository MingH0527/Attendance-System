@model WebAndMobile.Models.TeacherTimetableViewModel
@using WebAndMobile.Models

@{
    Layout = "_Layout";
    ViewData["Title"] = "My Timetable";


    // ==================================================
    // DATA
    // ==================================================

    List<TeacherTimetableItemViewModel> timetableItems =
        Model.Items
        ?? new List<TeacherTimetableItemViewModel>();


    List<AcademicWeek> weeks =
        Model.Weeks
        ?? new List<AcademicWeek>();


    List<TimetableNotification> notifications =
        Model.Notifications
        ?? new List<TimetableNotification>();



    // ==================================================
    // DAYS
    // ==================================================

    List<DayOfWeek> days =
        new()
        {
            DayOfWeek.Monday,
            DayOfWeek.Tuesday,
            DayOfWeek.Wednesday,
            DayOfWeek.Thursday,
            DayOfWeek.Friday,
            DayOfWeek.Saturday
        };


    // Sunday only appears when there is a Sunday class.

    if (
        timetableItems.Any(i =>
            i.DayOfWeek ==
                DayOfWeek.Sunday
        )
    )
    {
        days.Add(
            DayOfWeek.Sunday
        );
    }



    // ==================================================
    // TIME RANGE
    // ==================================================

    int startHour = 8;
    int endHour = 18;


    if (timetableItems.Count > 0)
    {
        int earliestHour =
            timetableItems
                .Min(i =>
                    i.StartTime.Hours
                );


        int latestHour =
            timetableItems
                .Max(i =>
                    i.EndTime.Minutes > 0
                        ? i.EndTime.Hours + 1
                        : i.EndTime.Hours
                );


        if (earliestHour < startHour)
        {
            startHour =
                earliestHour;
        }


        if (latestHour > endHour)
        {
            endHour =
                latestHour;
        }
    }



    // ==================================================
    // NOTIFICATION COUNT
    // ==================================================

    int recentNotificationCount =
        notifications.Count;


    if (
        ViewBag.RecentNotificationCount !=
        null
    )
    {
        recentNotificationCount =
            Convert.ToInt32(
                ViewBag.RecentNotificationCount
            );
    }
}



@section Styles
{
    <link rel="stylesheet"
          href="~/css/student-timetable.css"
          asp-append-version="true" />
}



<div class="student-timetable-page">


    <!-- ==================================================
         CURRENT VIEW
         ================================================== -->

    <div class="current-view-card">


        <!-- LEFT -->

        <div class="current-view-left">


            <span class="small-label">
                CURRENT VIEW
            </span>


            @if (Model.IsTemplate)
            {
                <h2>
                    Weekly Template
                </h2>


                <p>
                    @Model.TermName
                </p>
            }
            else
            {
                <h2>
                    Week @(Model.SelectedWeekNumber ?? 1)
                </h2>


                @if (
                    Model.WeekStart.HasValue &&
                    Model.WeekEnd.HasValue
                )
                {
                    <p>

                        @Model.WeekStart.Value.ToString("dd/MM/yyyy")

                        -

                        @Model.WeekEnd.Value.ToString("dd/MM/yyyy")

                    </p>
                }
            }


        </div>



        <!-- RIGHT -->

        <div class="current-view-right">


            <label for="weekNumber">
                View:
            </label>


            <form asp-controller="Student"
                  asp-action="Timetable"
                  method="get"
                  class="week-form">


                <select id="weekNumber"
                        name="weekNumber"
                        class="week-select"
                        onchange="this.form.submit()">


                    <!-- WEEKLY TEMPLATE -->

                    @if (Model.IsTemplate)
                    {
                        <option value="0"
                                selected>

                            Weekly Template

                        </option>
                    }
                    else
                    {
                        <option value="0">

                            Weekly Template

                        </option>
                    }



                    <!-- ACADEMIC WEEKS -->

                    @foreach (
                        AcademicWeek week
                        in weeks
                    )
                    {
                        if (
                            !Model.IsTemplate &&
                            Model.SelectedWeekNumber ==
                                week.WeekNumber
                        )
                        {
                            <option value="@week.WeekNumber"
                                    selected>

                                Week @week.WeekNumber
                                (@week.StartDate.ToString("dd/MM")
                                -
                                @week.EndDate.ToString("dd/MM"))

                            </option>
                        }
                        else
                        {
                            <option value="@week.WeekNumber">

                                Week @week.WeekNumber
                                (@week.StartDate.ToString("dd/MM")
                                -
                                @week.EndDate.ToString("dd/MM"))

                            </option>
                        }
                    }


                </select>


            </form>


        </div>


    </div>



    <!-- ==================================================
         LEGEND
         ================================================== -->

    <div class="timetable-legend">


        <div class="legend-item">

            <span class="legend-box subject">
            </span>

            <span>
                Subject
            </span>

        </div>



        <div class="legend-item">

            <span class="legend-box replacement">
            </span>

            <span>
                Replacement
            </span>

        </div>



        <div class="legend-item">

            <span class="legend-box cancelled">
            </span>

            <span>
                Cancelled
            </span>

        </div>


    </div>



    <!-- ==================================================
         RECENT TIMETABLE CHANGES
         ================================================== -->

    <div class="recent-changes">


        <!-- HEADER -->

        <div class="changes-header">


            <div class="changes-title">


                <span class="bell-icon">
                    🔔
                </span>


                <strong>
                    Recent Timetable Changes
                </strong>


            </div>



            <div class="changes-count">


                <span>
                    @recentNotificationCount
                </span>


                <strong>
                    Latest changes
                </strong>


            </div>


        </div>



        <!-- NOTIFICATIONS -->

        @if (notifications.Count > 0)
        {

            <div class="changes-list">


                @foreach (
                    TimetableNotification notification
                    in notifications
                )
                {

                    <div class="change-item">


                        <div class="change-content">


                            <strong>
                                @notification.Type
                            </strong>


                            <p>
                                @notification.Message
                            </p>


                        </div>



                        <small>

                            @notification.CreatedAt.ToString("dd/MMM yyyy HH:mm")

                        </small>


                    </div>

                }


            </div>

        }
        else
        {

            <div class="changes-list">


                <div class="change-item">


                    <div class="change-content">

                        <p>
                            No recent timetable changes.
                        </p>

                    </div>


                </div>


            </div>

        }


    </div>



    <!-- ==================================================
         TIMETABLE
         ================================================== -->

    <div class="timetable-grid-wrapper">


        @if (timetableItems.Count == 0)
        {

            <!-- EMPTY -->

            <div class="empty-timetable">


                <div class="empty-icon">
                    📅
                </div>


                <h2>
                    No timetable entries
                </h2>


                <p>

                    There are currently no timetable
                    entries available for this semester.

                </p>


            </div>

        }
        else
        {

            <!-- TABLE -->

            <div class="timetable-scroll">


                <table class="teacher-style-timetable">


                    <!-- ==================================================
                         HEADER
                         ================================================== -->

                    <thead>


                        <tr>


                            <th class="day-column">

                                Day

                            </th>



                            @for (
                                int hour = startHour;
                                hour < endHour;
                                hour++
                            )
                            {

                                DateTime startTime =
                                    DateTime.Today.AddHours(
                                        hour
                                    );


                                DateTime endTime =
                                    startTime.AddHours(
                                        1
                                    );


                                <th class="time-column">


                                    <strong>

                                        @startTime.ToString("hh:mm tt")

                                    </strong>


                                    <span>

                                        @endTime.ToString("hh:mm tt")

                                    </span>


                                </th>

                            }


                        </tr>


                    </thead>



                    <!-- ==================================================
                         BODY
                         ================================================== -->

                    <tbody>


                        @foreach (
                            DayOfWeek day
                            in days
                        )
                        {

                            // ==============================================
                            // ACTUAL DATE FOR THIS DAY
                            // ==============================================

                            DateTime? actualDate =
                                null;


                            if (
                                !Model.IsTemplate &&
                                Model.WeekStart.HasValue
                            )
                            {

                                DateTime weekStart =
                                    Model.WeekStart.Value.Date;


                                int difference =
                                    (
                                        (int)day -
                                        (int)weekStart.DayOfWeek +
                                        7
                                    )
                                    % 7;


                                actualDate =
                                    weekStart
                                        .AddDays(
                                            difference
                                        )
                                        .Date;
                            }



                            <tr>


                                <!-- ======================================
                                     DAY
                                     ====================================== -->

                                <td class="day-cell">


                                    <strong>
                                        @day
                                    </strong>


                                    @if (
                                        actualDate.HasValue
                                    )
                                    {

                                        <span>

                                            @actualDate.Value.ToString("dd/MM/yyyy")

                                        </span>

                                    }


                                </td>



                                <!-- ======================================
                                     HOURS
                                     ====================================== -->

                                @for (
                                    int hour = startHour;
                                    hour < endHour;
                                    hour++
                                )
                                {

                                    // ======================================
                                    // ITEMS STARTING IN THIS HOUR
                                    // ======================================

                                    List<TeacherTimetableItemViewModel>
                                        cellItems =
                                            timetableItems
                                                .Where(i =>
                                                    i.DayOfWeek ==
                                                        day &&
                                                    i.StartTime.Hours ==
                                                        hour
                                                )
                                                .OrderBy(i =>
                                                    i.StartTime
                                                )
                                                .ToList();



                                    <td class="schedule-cell">


                                        @foreach (
                                            TeacherTimetableItemViewModel item
                                            in cellItems
                                        )
                                        {

                                            // ==================================
                                            // STATUS
                                            // ==================================

                                            string status =
                                                item.Status?.Trim()
                                                ?? "Normal";


                                            string cardClass =
                                                "subject-card";


                                            if (
                                                string.Equals(
                                                    status,
                                                    "Replacement",
                                                    StringComparison.OrdinalIgnoreCase
                                                )
                                            )
                                            {
                                                cardClass +=
                                                    " replacement-card";
                                            }
                                            else if (
                                                string.Equals(
                                                    status,
                                                    "Cancelled",
                                                    StringComparison.OrdinalIgnoreCase
                                                )
                                            )
                                            {
                                                cardClass +=
                                                    " cancelled-card";
                                            }



                                            <!-- ==============================
                                                 SUBJECT CARD
                                                 ============================== -->

                                            <div class="@cardClass">


                                                <!-- STATUS -->

                                                @if (
                                                    string.Equals(
                                                        status,
                                                        "Replacement",
                                                        StringComparison.OrdinalIgnoreCase
                                                    )
                                                )
                                                {

                                                    <span class="subject-status replacement-status">

                                                        Replacement

                                                    </span>

                                                }
                                                else if (
                                                    string.Equals(
                                                        status,
                                                        "Cancelled",
                                                        StringComparison.OrdinalIgnoreCase
                                                    )
                                                )
                                                {

                                                    <span class="subject-status cancelled-status">

                                                        Cancelled

                                                    </span>

                                                }



                                                <!-- COURSE -->

                                                <div class="subject-name">

                                                    @item.CourseName

                                                </div>



                                                <!-- TIME -->

                                                <div class="subject-time">

                                                    @(item.StartTime.ToString(@"hh\:mm"))

                                                    -

                                                    @(item.EndTime.ToString(@"hh\:mm"))

                                                </div>



                                                <!-- CLASS -->

                                                <div class="subject-class">

                                                    @item.ClassName

                                                </div>



                                                <!-- ROOM -->

                                                <div class="subject-room">

                                                    Room:
                                                    @item.RoomName

                                                </div>



                                                <!-- CLASS TYPE -->

                                                <span class="subject-type">

                                                    @item.ClassType

                                                </span>



                                                <!-- OCCURRENCE DATE -->

                                                @if (
                                                    item.OccurrenceDate.HasValue
                                                )
                                                {

                                                    <div class="subject-date">

                                                        @item.OccurrenceDate.Value.ToString("d/MM/yyyy")

                                                    </div>

                                                }



                                                <!-- REASON -->

                                                @if (
                                                    !string.IsNullOrWhiteSpace(
                                                        item.Reason
                                                    )
                                                )
                                                {

                                                    <div class="subject-reason">

                                                        @item.Reason

                                                    </div>

                                                }


                                            </div>

                                        }


                                    </td>

                                }


                            </tr>

                        }


                    </tbody>


                </table>


            </div>

        }


    </div>


</div>