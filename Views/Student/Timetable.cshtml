@model List<WebAndMobile.Models.Timetable>

@{
    Layout = "_Layout";

    ViewData["Title"] =
        "My Timetable";

    DayOfWeek[] days =
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };
}


@section Styles {

    <link rel="stylesheet"
          href="~/css/student-timetable.css"
          asp-append-version="true" />

}


<div class="student-timetable-page">


    <!-- ==============================
         HEADER
         ============================== -->

    <div class="timetable-header">

        <div>

            <p class="timetable-label">
                Student Portal
            </p>

            <h1>
                My Timetable
            </h1>

            <p class="timetable-description">
                View your weekly class schedule
                for the current semester.
            </p>

        </div>

    </div>


    <!-- ==============================
         STUDENT INFORMATION
         ============================== -->

    <div class="timetable-summary">

        <div class="summary-item">

            <span>
                Class
            </span>

            <strong>
                @ViewBag.ClassName
            </strong>

        </div>


        <div class="summary-item">

            <span>
                Program
            </span>

            <strong>
                @ViewBag.ProgramName
            </strong>

        </div>


        <div class="summary-item">

            <span>
                Semester
            </span>

            <strong>
                @ViewBag.TermName
            </strong>

        </div>

    </div>



    <!-- ==============================
         NO TIMETABLE
         ============================== -->
    @if (Model.Count == 0)
    {
        <div class="empty-timetable">

            <div class="empty-icon">
                📅
            </div>

            <h2>
                No timetable available
            </h2>

            <p>
                Your timetable will appear here
                once your class and active semester
                have been configured.
            </p>

        </div>
    }

    else
    {

        <!-- ==============================
             WEEKLY TIMETABLE
             ============================== -->

        <div class="weekly-timetable">

            @foreach (DayOfWeek day in days)
            {
                List<Timetable> dayEntries =
                    Model
                        .Where(t =>
                            t.DayOfWeek == day)
                        .OrderBy(t =>
                            t.StartTime)
                        .ToList();


                <div class="day-section">

                    <div class="day-heading">

                        <h2>
                            @day
                        </h2>

                        <span>
                            @dayEntries.Count class(es)
                        </span>

                    </div>


                    @if (dayEntries.Count == 0)
                    {
                        <div class="no-class">

                            No classes scheduled.

                        </div>
                    }

                    else
                    {

                        <div class="class-list">

                            @foreach (
                                Timetable item
                                in dayEntries)
                            {

                                <div class="class-card">


                                    <!-- TIME -->

                                    <div class="class-time">

                                        <strong>

                                            @(DateTime.Today.Add(item.StartTime).ToString("hh:mm tt"))

                                        </strong>

                                        <span>
                                            to
                                        </span>

                                        <strong>

                                            @(DateTime.Today.Add(item.EndTime).ToString("hh:mm tt"))

                                        </strong>

                                    </div>


                                    <!-- SUBJECT -->

                                    <div class="class-details">

                                        <div class="course-title">

                                            @if (
                                                !string.IsNullOrWhiteSpace(
                                                    item.Course?.CourseCode))
                                            {
                                                <span class="course-code">

                                                    @item.Course.CourseCode

                                                </span>
                                            }


                                            <h3>

                                                @(item.Course?.CourseName
                                                    ?? "Unknown Subject")

                                            </h3>

                                        </div>


                                        <div class="class-meta">


                                            <span>

                                                <strong>
                                                    Teacher:
                                                </strong>

                                                @item.Teacher.Username

                                            </span>


                                            <span>

                                                <strong>
                                                    Room:
                                                </strong>

                                                @(item.Classroom?.RoomName
                                                    ?? "TBA")

                                            </span>


                                            <span>

                                                <strong>
                                                    Type:
                                                </strong>

                                                @item.ClassType

                                            </span>


                                        </div>

                                    </div>


                                </div>

                            }

                        </div>

                    }

                </div>
            }

        </div>

    }


</div>