@model WebAndMobile.Models.StudentAttendanceViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Attendance";

    <link rel="stylesheet"
          href="~/css/student.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/student-attendance.css"
          asp-append-version="true" />
}

<div class="attendance-page">

    <div class="attendance-heading">
        <span>ATTENDANCE</span>
        <h1>My Attendance</h1>
        <p>
            Submit your attendance code and review
            your attendance performance.
        </p>
    </div>


    @if (TempData["AttendanceSuccess"] != null)
    {
        <div class="attendance-message success">
            @TempData["AttendanceSuccess"]
        </div>
    }

    @if (TempData["AttendanceError"] != null)
    {
        <div class="attendance-message error">
            @TempData["AttendanceError"]
        </div>
    }


    <!-- ENTER CODE -->
    <section class="attendance-card code-card">

        <div>
            <span class="section-label">
                CHECK IN
            </span>

            <h2>
                Enter Attendance Code
            </h2>

            <p>
                Enter the 6-digit code generated by
                your teacher.
            </p>
        </div>


        <form asp-controller="Student"
              asp-action="SubmitAttendanceCode"
              method="post"
              class="code-form">

            @Html.AntiForgeryToken()

            <input type="text"
                   name="code"
                   maxlength="6"
                   inputmode="numeric"
                   pattern="[0-9]{6}"
                   placeholder="6-digit code"
                   autocomplete="off" />

            <button type="submit">
                Submit Attendance
            </button>

        </form>

    </section>


    <!-- TODAY -->
    <section class="attendance-card">

        <div class="section-heading">
            <div>
                <span class="section-label">
                    TODAY
                </span>

                <h2>
                    Today's Attendance
                </h2>
            </div>
        </div>


        @if (Model.TodayAttendance.Count == 0)
        {
            <div class="attendance-empty">
                No classes scheduled for today.
            </div>
        }
        else
        {
            <div class="today-attendance-list">

                @foreach (var item in Model.TodayAttendance)
                {
                    string statusClass =
                        item.Status
                            .ToLower()
                            .Replace(" ", "-");

                    <div class="today-attendance-row">

                        <div class="attendance-course">

                            <strong>
                                @item.CourseName
                            </strong>

                            <span>
                                @item.CourseCode
                            </span>

                        </div>


                        <div class="attendance-time">
                            @item.StartTime.ToString(@"hh\:mm")
                            -
                            @item.EndTime.ToString(@"hh\:mm")
                        </div>


                        <span class="attendance-status @statusClass">
                            @item.Status
                        </span>

                    </div>
                }

            </div>
        }

    </section>


    <!-- OVERALL -->
    <section>

        <div class="section-heading overall-heading">

            <div>
                <span class="section-label">
                    OVERALL
                </span>

                <h2>
                    Overall Attendance
                </h2>

                <p>
                    Select a subject to view the full
                    attendance history.
                </p>
            </div>

        </div>


        <div class="subject-attendance-grid">

            @foreach (var item in Model.Subjects)
            {
                string percentageClass =
                    item.Percentage < 80
                        ? "low"
                        : "good";

                <a asp-controller="Student"
                   asp-action="AttendanceDetails"
                   asp-route-courseId="@item.CourseId"
                   class="subject-attendance-card">

                    <div class="subject-info">

                        <span class="subject-code">
                            @item.CourseCode
                        </span>

                        <h3>
                            @item.CourseName
                        </h3>


                        <div class="subject-counts">

                            <span>
                                Present
                                <strong>@item.PresentCount</strong>
                            </span>

                            <span>
                                Absent
                                <strong>@item.AbsentCount</strong>
                            </span>

                            <span>
                                Leave
                                <strong>@item.LeaveCount</strong>
                            </span>

                        </div>

                    </div>


                    <div class="attendance-percentage @percentageClass">

                        <strong>
                            @item.Percentage.ToString("0.#")%
                        </strong>

                    </div>

                </a>
            }

        </div>

    </section>

</div>