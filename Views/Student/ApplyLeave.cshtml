@using WebAndMobile.Models
@model WebAndMobile.Models.ApplyLeaveViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Apply Leave";

    AcademicTerm? activeTerm =
        ViewBag.ActiveLeaveTerm
        as AcademicTerm;

    DateTime today =
        DateTime.Today;

    bool hasActiveTerm =
        activeTerm != null;

    DateTime minimumDate =
        activeTerm != null &&
        activeTerm.StartDate.Date > today
            ? activeTerm.StartDate.Date
            : today;

    DateTime maximumDate =
        activeTerm?.EndDate.Date
        ?? today;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/apply-leave.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/apply-leave.js"
            asp-append-version="true">
    </script>

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const startDate =
                    document.getElementById(
                        "startDate"
                    );

                const endDate =
                    document.getElementById(
                        "endDate"
                    );

                if (
                    !startDate ||
                    !endDate
                ) {
                    return;
                }

                function formatDate(
                    date
                ) {
                    const year =
                        date.getFullYear();

                    const month =
                        String(
                            date.getMonth() + 1
                        ).padStart(
                            2,
                            "0"
                        );

                    const day =
                        String(
                            date.getDate()
                        ).padStart(
                            2,
                            "0"
                        );

                    return (
                        year +
                        "-" +
                        month +
                        "-" +
                        day
                    );
                }

                function addDays(
                    dateString,
                    days
                ) {
                    const parts =
                        dateString
                            .split("-")
                            .map(Number);

                    const date =
                        new Date(
                            parts[0],
                            parts[1] - 1,
                            parts[2]
                        );

                    date.setDate(
                        date.getDate() +
                        days
                    );

                    return formatDate(
                        date
                    );
                }

                function updateEndDate() {

                    if (
                        !startDate.value
                    ) {
                        return;
                    }

                    endDate.min =
                        startDate.value;

                    const sevenDayMaximum =
                        addDays(
                            startDate.value,
                            6
                        );

                    const semesterMaximum =
                        startDate.max;

                    if (
                        sevenDayMaximum <
                        semesterMaximum
                    ) {
                        endDate.max =
                            sevenDayMaximum;
                    }
                    else
                    {
                        endDate.max =
                            semesterMaximum;
                    }

                    if (
                        !endDate.value ||
                        endDate.value <
                            endDate.min ||
                        endDate.value >
                            endDate.max
                    ) {
                        endDate.value =
                            startDate.value;
                    }
                }

                startDate.addEventListener(
                    "change",
                    function () {
                        updateEndDate();
                    }
                );

                updateEndDate();
            }
        );
    </script>
}

<div class="leave-page">

    <!-- ==============================
         PAGE HEADER
         ============================== -->

    <div class="leave-header">

        <h1>Apply Leave</h1>

        <p>
            Submit your leave application
            and view your leave history.
        </p>

    </div>


    <!-- ==============================
         SUCCESS MESSAGE
         ============================== -->
    @if (
            TempData["SuccessMessage"] != null
        )
    {
        <div class="leave-alert success-alert">

            @TempData["SuccessMessage"]

        </div>
    }


    <!-- ==============================
         ERROR MESSAGE
         ============================== -->
    @if (
            TempData["ErrorMessage"] != null
        )
    {
        <div class="leave-alert error-alert">

            @TempData["ErrorMessage"]

        </div>
    }


    <!-- ==============================
         NEW LEAVE APPLICATION
         ============================== -->

    <div class="leave-card">

        <h2>New Leave Application</h2>

        <form asp-controller="Student"
              asp-action="ApplyLeave"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()


            <!-- ==============================
                 LEAVE TYPE
                 ============================== -->

            <div class="form-group">

                <label asp-for="LeaveType">
                    Leave Type
                </label>

                <select asp-for="LeaveType"
                        class="form-control">

                    <option value="">
                        -- Select Leave Type --
                    </option>

                    <option value="Medical Leave">
                        Medical Leave
                    </option>

                    <option value="Personal Leave">
                        Personal Leave
                    </option>

                    <option value="Emergency Leave">
                        Emergency Leave
                    </option>

                    <option value="Family Matter">
                        Family Matter
                    </option>

                    <option value="Other">
                        Other
                    </option>

                </select>

                <span asp-validation-for="LeaveType"
                      class="field-error">
                </span>

            </div>


            <!-- ==============================
                 START DATE + END DATE
                 ============================== -->

            <div class="date-row">

                <!-- Start Date -->

                <div class="form-group">

                    <label asp-for="StartDate">
                        Start Date
                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           id="startDate"
                           min="@minimumDate.ToString("yyyy-MM-dd")"
                           max="@maximumDate.ToString("yyyy-MM-dd")"
                           class="form-control"
                           disabled="@(!hasActiveTerm)" />

                    <span asp-validation-for="StartDate"
                          class="field-error">
                    </span>

                </div>


                <!-- End Date -->

                <div class="form-group">

                    <label asp-for="EndDate">
                        End Date
                    </label>

                    <input asp-for="EndDate"
                           type="date"
                           id="endDate"
                           min="@minimumDate.ToString("yyyy-MM-dd")"
                           max="@maximumDate.ToString("yyyy-MM-dd")"
                           class="form-control"
                           disabled="@(!hasActiveTerm)" />

                    <span asp-validation-for="EndDate"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- ==============================
                 DATE / LEAVE ERROR
                 ============================== -->

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary leave-date-validation">
            </div>


            @if (
                hasActiveTerm
            )
            {
                <small class="leave-date-note">
                    Only dates within the current semester can be chosen.
                    Maximum 7 consecutive leave days per application.
                </small>
            }
            else
            {
                <small class="leave-date-note field-error">
                    There is currently no active semester.
                    Leave application is unavailable.
                </small>
            }


            <!-- ==============================
                 REASON
                 ============================== -->

            <div class="form-group">

                <label asp-for="Reason">
                    Reason
                </label>

                <textarea asp-for="Reason"
                          class="form-control reason-box"
                          rows="5"
                          maxlength="500"
                          placeholder="Enter your reason..."></textarea>

                <span asp-validation-for="Reason"
                      class="field-error">
                </span>

            </div>


            <!-- ==============================
                 SUPPORTING DOCUMENT
                 ============================== -->

            <div class="form-group">

                <label asp-for="SupportingDocument">
                    Supporting Document
                </label>

                <input asp-for="SupportingDocument"
                       type="file"
                       accept=".pdf,.jpg,.jpeg,.png"
                       class="form-control" />

                <small>
                    Optional. PDF, JPG, JPEG or PNG.
                    Maximum 5MB.
                </small>

                <span asp-validation-for="SupportingDocument"
                      class="field-error">
                </span>

            </div>


            <!-- ==============================
                 FORM BUTTONS
                 ============================== -->

            <div class="form-actions">

                <button type="reset"
                        class="btn-secondary">

                    Clear

                </button>

                <button type="submit"
                        class="btn-primary"
                        disabled="@(!hasActiveTerm)">

                    Submit Leave

                </button>

            </div>

        </form>

    </div>


    <!-- ==============================
         LEAVE HISTORY
         ============================== -->

    <div class="leave-card">

        <div class="history-header">

            <div>

                <h2>
                    My Leave Applications
                </h2>

                <p>
                    Check your previous leave
                    application status.
                </p>

            </div>

            <span class="application-count">

                @Model.LeaveHistory.Count application(s)

            </span>

        </div>


        <!-- ==============================
             NO LEAVE APPLICATION
             ============================== -->
        @if (
                    Model.LeaveHistory.Count ==
                    0
                )
        {
            <div class="empty-history">

                <h3>
                    No leave applications yet
                </h3>

                <p>
                    Your submitted leave applications
                    will appear here.
                </p>

            </div>
        }
        else
        {

            <!-- ==============================
                 LEAVE TABLE
                 ============================== -->

            <div class="table-wrapper">

                <table class="leave-table">

                    <thead>

                        <tr>

                            <th>Applied Date</th>
                            <th>Leave Type</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Document</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (
                            var leave
                            in Model.LeaveHistory
                        )
                        {
                            <tr>

                                <td>
                                    @leave.AppliedAt.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @leave.LeaveType
                                </td>

                                <td>
                                    @leave.StartDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @leave.EndDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @leave.Reason
                                </td>

                                <td>

                                    @{
                                        string statusClass =
                                            leave.Status
                                                .ToLower()
                                            switch
                                            {
                                                "approved"
                                                    => "status-approved",

                                                "rejected"
                                                    => "status-rejected",

                                                _
                                                    => "status-pending"
                                            };
                                    }

                                    <span class="status-badge @statusClass">

                                        @leave.Status

                                    </span>

                                </td>

                                <td>

                                    @if (
                                        !string.IsNullOrEmpty(
                                            leave.SupportingDocument
                                        )
                                    )
                                    {
                                        <a href="~/uploads/leave/@leave.SupportingDocument"
                                           target="_blank"
                                           class="document-link">

                                            View

                                        </a>
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (
                                        leave.Status ==
                                        "Pending"
                                    )
                                    {
                                        <form asp-controller="Student"
                                              asp-action="CancelLeave"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@leave.LeaveId" />

                                            <button type="submit"
                                                    class="cancel-button"
                                                    onclick="return confirm('Are you sure you want to cancel this leave application?');">

                                                Cancel

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>