@{
    ViewData["Title"] = "Student Home";
}

<link rel="stylesheet" href="~/css/student.css" />

<div class="student-home-page">

    <main class="student-home-container">

        <div class="student-home-card">

            <div class="student-icon">
                <span>🎓</span>
            </div>

            <p class="system-name">Attendance System</p>

            <h1>Student Home</h1>

            <p class="welcome-text">
                Welcome to your student account.
            </p>

            <div class="student-actions">

                <a asp-controller="Payment"
                   asp-action="SelectFee"
                   class="student-button payment-button">

                    <span class="button-icon">💳</span>

                    <span class="button-content">
                        <strong>Payment</strong>
                        <small>View and pay your fees</small>
                    </span>

                    <span class="button-arrow">›</span>
                </a>

                <form asp-controller="Student"
                      asp-action="Logout"
                      method="post"
                      class="logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="student-button logout-button">

                        <span class="button-icon">↪</span>

                        <span class="button-content">
                            <strong>Logout</strong>
                            <small>Sign out from your account</small>
                        </span>

                        <span class="button-arrow">›</span>
                    </button>

                </form>

            </div>

        </div>

    </main>

</div>