@model WebAndMobile.Models.ChatIndexViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Chat";

    string homeController =
        Model.CurrentRole == "Teacher"
            ? "Teacher"
            : "Student";

    string targetRole =
        Model.CurrentRole == "Student"
            ? "teacher"
            : "student";
}

<link rel="stylesheet"
      href="~/css/chat.css"
      asp-append-version="true" />

<div class="chat-app"
     id="chatApp"
     data-current-user-id="@Model.CurrentUserId"
     data-current-role="@Model.CurrentRole"
     data-selected-user-id="@(Model.SelectedUserId?.ToString() ?? "")">

    <aside class="chat-sidebar">

        <header class="chat-sidebar-header">

            <a class="chat-back-link"
               asp-controller="@homeController"
               asp-action="Index">
                <span aria-hidden="true">←</span>
                <span>Back</span>
            </a>

            <h1>Chat</h1>

            <p>
                @(Model.CurrentRole == "Student"
                    ? "Message your teachers"
                    : "Message your students")
            </p>

        </header>

        <div class="chat-search-wrap">

            <div class="chat-search-box">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                </svg>

                <input id="chatSearchInput"
                       type="search"
                       maxlength="60"
                       autocomplete="off"
                       placeholder="Search @targetRole name" />

            </div>

            <div id="chatSearchResults"
                 class="chat-search-results"
                 hidden>
            </div>

        </div>

        <div class="conversation-heading">
            <span>Messages</span>
            <span id="conversationCount">
                @Model.Conversations.Count
            </span>
        </div>

        <div id="conversationList"
             class="conversation-list">

            @if (Model.Conversations.Count == 0)
            {
                <div class="conversation-empty">
                    No conversations yet.
                </div>
            }

            @foreach (var item in Model.Conversations)
            {
                <button type="button"
                        class="conversation-item"
                        data-user-id="@item.OtherUserId"
                        data-conversation-id="@item.ConversationId">

                    <img src="~/image/@item.OtherAvatar"
                         alt="@item.OtherUsername"
                         onerror="this.src='/image/default.png'" />

                    <span class="conversation-main">

                        <span class="conversation-topline">

                            <strong>@item.OtherUsername</strong>

                            <time data-utc="@item.LastMessageAtUtc.ToString("O")">
                            </time>

                        </span>

                        <span class="conversation-bottomline">

                            <span class="conversation-preview">
                                @item.LastMessage
                            </span>

                            @if (item.UnreadCount > 0)
                            {
                                <span class="unread-badge">
                                    @item.UnreadCount
                                </span>
                            }

                        </span>

                    </span>

                </button>
            }

        </div>

    </aside>

    <main class="chat-panel">

        <section id="chatEmptyState"
                 class="chat-empty-state">

            <div class="empty-icon">💬</div>

            <h2>Select a conversation</h2>

            <p>
                Search for a @targetRole or open a previous conversation.
            </p>

        </section>

        <section id="activeChat"
                 class="active-chat"
                 hidden>

            <header class="active-chat-header">

                <div class="active-chat-user">

                    <img id="activeChatAvatar"
                         src="/image/default.png"
                         alt="Profile" />

                    <div class="active-chat-person">
                        <h2 id="activeChatName"></h2>
                        <p id="activeChatInfo"></p>
                    </div>

                </div>

                <div class="active-chat-actions">

                    <button id="startVideoCallButton"
                            class="header-icon-button"
                            type="button"
                            title="Start video call"
                            aria-label="Start video call">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M15 8.5V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1.5l5 3V5.5l-5 3Z" />
                        </svg>

                    </button>

                </div>

            </header>

            <div id="messageArea"
                 class="message-area">

                <div class="message-column">

                    <button id="loadOlderButton"
                            class="load-older-button"
                            type="button"
                            hidden>
                        Load older messages
                    </button>

                    <div id="messageList"
                         class="message-list">
                    </div>

                </div>

            </div>

            <footer class="message-composer">

                <div id="chatError"
                     class="chat-error"
                     hidden>
                </div>

                <div class="composer-shell">

                    <textarea id="messageInput"
                              maxlength="400"
                              rows="1"
                              placeholder="Type a message"
                              aria-label="Message"></textarea>

                    <div class="composer-bottom-row">

                        <span id="characterCount"
                              class="character-count">
                            0/400
                        </span>

                        <button id="sendMessageButton"
                                class="send-message-button"
                                type="button"
                                title="Send message"
                                aria-label="Send message"
                                disabled>

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M3.4 20.4 21 12 3.4 3.6l-.1 6.5 11.7 1.9-11.7 1.9.1 6.5Z" />
                            </svg>

                        </button>

                    </div>

                </div>

                <p class="composer-help">
                    Enter to send · Shift + Enter for a new line
                </p>

            </footer>

        </section>

    </main>

</div>

<!-- Incoming call dialog -->
<div id="incomingCallOverlay"
     class="call-overlay"
     hidden>

    <section class="incoming-call-card"
             role="dialog"
             aria-modal="true">

        <img id="incomingCallerAvatar"
             src="/image/default.png"
             alt="Caller" />

        <p class="call-label">Incoming video call</p>

        <h2 id="incomingCallerName">
            Incoming call
        </h2>

        <div class="incoming-call-actions">

            <button id="declineCallButton"
                    class="call-round-button call-decline"
                    type="button"
                    title="Decline">
                ✕
            </button>

            <button id="acceptCallButton"
                    class="call-round-button call-accept"
                    type="button"
                    title="Accept">
                ✓
            </button>

        </div>

    </section>

</div>

<!-- Active video call -->
<div id="videoCallOverlay"
     class="video-call-overlay"
     hidden>

    <div class="video-call-stage">

        <video id="remoteVideo"
               class="remote-video"
               autoplay
               playsinline>
        </video>

        <div id="remoteVideoPlaceholder"
             class="remote-video-placeholder">
            Connecting…
        </div>

        <video id="localVideo"
               class="local-video"
               autoplay
               muted
               playsinline>
        </video>

        <div class="video-call-topbar">

            <div>
                <strong id="videoCallPersonName">
                    Video call
                </strong>

                <span id="videoCallStatus">
                    Connecting…
                </span>

                <span id="videoCallTimer"
                      class="video-call-timer">
                    00:00
                </span>
            </div>

        </div>

        <div class="video-call-controls">

            <button id="toggleMicrophoneButton"
                    class="call-control-button"
                    type="button"
                    title="Mute microphone">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 1 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0M12 16v4m-3 0h6" />
                </svg>

            </button>

            <button id="toggleCameraButton"
                    class="call-control-button"
                    type="button"
                    title="Turn camera off">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M15 8.5V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1.5l5 3V5.5l-5 3Z" />
                </svg>

            </button>

            <button id="endCallButton"
                    class="call-control-button call-end-button"
                    type="button"
                    title="End call">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M5.5 15.5c4.2-3.4 8.8-3.4 13 0l2-2c-5.4-4.9-11.6-4.9-17 0l2 2Z" />
                </svg>

            </button>

        </div>

    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/9.0.6/signalr.min.js"></script>

<script src="~/js/chat.js"
        asp-append-version="true">
</script>
