@model WebAndMobile.Models.User

@{
    Layout = "_Layout";

    ViewData["Title"] = "Admin Home";

    int passkeyCount =
        ViewBag.PasskeyCount ?? 0;

    bool adminPinEnabled =
        ViewBag.AdminPinEnabled ?? false;
}

<link rel="stylesheet" href="~/css/adminhome.css" />
<link rel="stylesheet" href="~/css/CreateTeacher.css" />

<div class="dashboard-page">

    <header class="dashboard-header">
        <div>
            <p class="dashboard-role">
                Administrator Portal
            </p>

            <h1>
                Welcome, @Model.Username
            </h1>

            <p class="dashboard-subtitle">
                Manage the attendance system,
                timetable and account security.
            </p>
        </div>

        <div class="avatar-box">
            @{
                string storedAvatar =
                    string.IsNullOrWhiteSpace(Model.Avatar)
                        ? "default.png"
                        : Model.Avatar.Trim();

                string avatarUrl =
                    storedAvatar == "default.png" ||
                    storedAvatar == "default-avatar.png"
                        ? "/image/default.png"
                        : storedAvatar.StartsWith("/") ||
                          storedAvatar.StartsWith("http://") ||
                          storedAvatar.StartsWith("https://")
                            ? storedAvatar
                            : $"/uploads/avatars/{storedAvatar}";
            }

            <img src="@avatarUrl"
                 alt="Admin profile picture"
                 onerror="this.onerror=null; this.src='/image/default.png';" />
        </div>
    </header>


    <section class="security-summary">

        <div class="summary-card">

            <span class="summary-label">
                Account Role
            </span>

            <strong>
                @Model.Position
            </strong>

        </div>


        <div class="summary-card">

            <span class="summary-label">
                Registered Passkeys
            </span>

            <strong>
                @passkeyCount / 3
            </strong>

        </div>


        <div class="summary-card">

            <span class="summary-label">
                Admin Security PIN
            </span>

            @if (adminPinEnabled)
            {
                <strong class="status-enabled">
                    Enabled
                </strong>
            }
            else
            {
                <strong class="status-warning">
                    Not configured
                </strong>
            }

        </div>

    </section>


    <section class="dashboard-grid">


        <!-- My Profile -->

        <a asp-controller="MyProfile"
           asp-action="Index"
           class="dashboard-card">

            <div class="card-icon">
                👤
            </div>

            <div>

                <h2>
                    My Profile
                </h2>

                <p>
                    View your account information
                    and security settings.
                </p>

            </div>

        </a>


        <!-- Passkey -->

        <a asp-controller="MyProfile"
           asp-action="Passkey"
           class="dashboard-card">

            <div class="card-icon">
                🔐
            </div>

            <div>

                <h2>
                    Passkey & PIN
                </h2>

                <p>
                    Register passkeys and configure
                    the Admin Security PIN.
                </p>

            </div>

        </a>


        <!-- Timetable -->

        <a asp-controller="Admin"
           asp-action="Timetable"
           class="dashboard-card">

            <div class="card-icon">
                📅
            </div>

            <div>

                <h2>
                    Timetable
                </h2>

                <p>
                    Create, update and manage
                    timetable entries.
                </p>

            </div>

        </a>


        <!-- Program & Subject -->

        <a asp-controller="ProgramSubject"
           asp-action="Index"
           class="dashboard-card">

            <div class="card-icon">
                📚
            </div>

            <div>

                <h2>
                    Program &amp; Subject CRUD
                </h2>

                <p>
                    Create programs and subjects,
                    then assign subjects to programs.
                </p>

            </div>

        </a>


        <!-- User Management -->

        <a asp-controller="User"
           asp-action="Index"
           class="dashboard-card">

            <div class="card-icon">
                👥
            </div>

            <div>

                <h2>
                    User Management
                </h2>

                <p>
                    View, edit and manage
                    user accounts.
                </p>

            </div>

        </a>


        <!-- Leave Management -->

        <a asp-controller="Admin"
           asp-action="LeaveManagement"
           class="dashboard-card">

            <div class="card-icon">
                📝
            </div>

            <div>

                <h2>
                    Leave Management
                </h2>

                <p>
                    Review student leave applications
                    and approve or reject requests.
                </p>

            </div>

        </a>


        <!-- Barred List -->

        <a asp-controller="Admin"
           asp-action="BarredList"
           class="dashboard-card">

            <div class="card-icon">
                🚫
            </div>

            <div>

                <h2>
                    Barred List
                </h2>

                <p>
                    Manage students with attendance
                    of 80% or below.
                </p>

            </div>

        </a>


        <!-- Logout -->

        <div class="dashboard-card logout-card">

            <div class="card-icon">
                🚪
            </div>

            <div>

                <h2>
                    Logout
                </h2>

                <p>
                    End the current administrator
                    session securely.
                </p>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="logout-button">

                        Logout

                    </button>

                </form>

            </div>

        </div>

    </section>

</div>