@model WebAndMobile.Models.BarredListViewModel

@{
    Layout = "_Layout";

    ViewData["Title"] =
        "Barred List";

    int barredPage =
        ViewBag.BarredPage ?? 1;

    int barredTotalPages =
        ViewBag.BarredTotalPages ?? 1;

    int barredTotalCount =
        ViewBag.BarredTotalCount ?? 0;


    int eligiblePage =
        ViewBag.EligiblePage ?? 1;

    int eligibleTotalPages =
        ViewBag.EligibleTotalPages ?? 1;

    int eligibleTotalCount =
        ViewBag.EligibleTotalCount ?? 0;
}

<link rel="stylesheet"
      href="~/css/barredlist.css"
      asp-append-version="true" />


<div class="barred-page">

    <div class="barred-header">

        <div>

            <p class="barred-eyebrow">
                ADMIN MANAGEMENT
            </p>

            <h1>
                Barred List
            </h1>

            <p>
                Manage students whose attendance
                has reached 80% or below.
            </p>

        </div>


        <a asp-controller="Admin"
           asp-action="Index"
           class="barred-back">

            ← Admin Home

        </a>

    </div>


    <!-- ==========================================
         SUCCESS / ERROR
         ========================================== -->
    @if (
            TempData["BarredSuccess"]
            is string success
        )
    {
        <div class="barred-alert success">
            @success
        </div>
    }


    @if (
        TempData["BarredError"]
        is string error
    )
    {
        <div class="barred-alert error">
            @error
        </div>
    }


    <!-- ==========================================
         CURRENT BARRED STUDENTS
         ========================================== -->

    <section class="barred-card">

        <div class="section-title">

            <div>

                <h2>
                    Current Barred Students
                </h2>

                <p>
                    Students currently restricted
                    because of attendance issues.
                </p>

            </div>


            <span class="count-badge">
                @barredTotalCount
            </span>

        </div>


        @if (
            barredTotalCount ==
            0
        )
        {
            <div class="empty-state">

                <div class="empty-icon">
                    🚫
                </div>

                <strong>
                    No barred students
                </strong>

                <p>
                    Students added to the barred list
                    will appear here.
                </p>

            </div>
        }
        else
        {
            <div class="table-wrapper">

                <table class="barred-table">

                    <thead>

                        <tr>

                            <th>
                                Student ID
                            </th>

                            <th>
                                Student
                            </th>

                            <th>
                                Program
                            </th>

                            <th>
                                Subject
                            </th>

                            <th>
                                Absent
                            </th>

                            <th>
                                Attendance
                            </th>

                            <th>
                                Reason
                            </th>

                            <th>
                                Barred Date
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            var student
                            in Model.BarredStudents
                        )
                        {
                            double percentage =
                                Math.Round(
                                    student
                                        .AttendancePercentage,
                                    1
                                );

                            <tr>

                                <td>

                                    <strong>
                                        @student.StudentId
                                    </strong>

                                </td>


                                <td>
                                    @student.Username
                                </td>


                                <td>
                                    @student.ProgramName
                                </td>


                                <td>

                                    <div class="subject-cell">

                                        @if (
                                            !string.IsNullOrWhiteSpace(
                                                student.CourseCode
                                            )
                                        )
                                        {
                                            <strong>
                                                @student.CourseCode
                                            </strong>
                                        }

                                        <span>
                                            @student.CourseName
                                        </span>

                                    </div>

                                </td>


                                <td>

                                    <span class="absent-badge">
                                        @student.AbsentCount
                                    </span>

                                </td>


                                <td>

                                    <span class="attendance-badge danger">

                                        @percentage.ToString("0.#")%

                                    </span>

                                </td>


                                <td>

                                    <form asp-controller="Admin"
                                          asp-action="EditBarredStudent"
                                          method="post"
                                          class="reason-form">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="id"
                                               value="@student.BarredStudentId" />


                                        <input type="text"
                                               name="reason"
                                               value="@student.Reason"
                                               maxlength="300"
                                               required />


                                        <button type="submit"
                                                class="edit-button">

                                            Save

                                        </button>

                                    </form>

                                </td>


                                <td>

                                    @student.BarredAt.ToString("dd/MM/yyyy")
                                </td>


                                <td>

                                    <form asp-controller="Admin"
                                          asp-action="RemoveBarredStudent"
                                          method="post">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="id"
                                               value="@student.BarredStudentId" />


                                        <button type="submit"
                                                class="remove-button"
                                                onclick="return confirm('Remove this student from the barred list?');">

                                            Remove

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- ==================================
                 BARRED PAGINATION
                 ================================== -->
            @if (
                            barredTotalPages >
                            1
                        )
            {
                <div class="pagination-wrapper">

                    <span class="page-info">

                        Page
                        @barredPage
                        of
                        @barredTotalPages

                    </span>


                    <div class="pagination">


                        @if (
                            barredPage >
                            1
                        )
                        {
                            <a asp-controller="Admin"
                               asp-action="BarredList"
                               asp-route-barredPage="@(barredPage - 1)"
                               asp-route-eligiblePage="@eligiblePage"
                               class="page-button">

                                ← Previous

                            </a>
                        }
                        else
                        {
                            <span class="page-button disabled">
                                ← Previous
                            </span>
                        }


                        @for (
                            int i = 1;
                            i <= barredTotalPages;
                            i++
                        )
                        {
                            <a asp-controller="Admin"
                               asp-action="BarredList"
                               asp-route-barredPage="@i"
                               asp-route-eligiblePage="@eligiblePage"
                               class="page-number @(i == barredPage ? "active" : "")">

                                @i

                            </a>
                        }


                        @if (
                            barredPage <
                            barredTotalPages
                        )
                        {
                            <a asp-controller="Admin"
                               asp-action="BarredList"
                               asp-route-barredPage="@(barredPage + 1)"
                               asp-route-eligiblePage="@eligiblePage"
                               class="page-button">

                                Next →

                            </a>
                        }
                        else
                        {
                            <span class="page-button disabled">
                                Next →
                            </span>
                        }

                    </div>

                </div>
            }

        }

    </section>


    <!-- ==========================================
         ELIGIBLE FOR BARRED LIST
         ========================================== -->

    <section class="barred-card">

        <div class="section-title">

            <div>

                <h2>
                    Eligible for Barred List
                </h2>

                <p>
                    Students with subject attendance
                    of 80% or below.
                </p>

            </div>


            <span class="count-badge warning">
                @eligibleTotalCount
            </span>

        </div>


        @if (
            eligibleTotalCount ==
            0
        )
        {
            <div class="empty-state">

                <div class="empty-icon">
                    ✅
                </div>

                <strong>
                    No students are currently eligible
                </strong>

                <p>
                    Students will appear here when
                    their attendance reaches 80% or below.
                </p>

            </div>
        }
        else
        {
            <div class="table-wrapper">

                <table class="barred-table">

                    <thead>

                        <tr>

                            <th>
                                Student ID
                            </th>

                            <th>
                                Student
                            </th>

                            <th>
                                Program
                            </th>

                            <th>
                                Subject
                            </th>

                            <th>
                                Absent
                            </th>

                            <th>
                                Attendance
                            </th>

                            <th>
                                Reason
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            var student
                            in Model.EligibleStudents
                        )
                        {
                            double percentage =
                                Math.Round(
                                    student
                                        .AttendancePercentage,
                                    1
                                );


                            string formId =
                                $"barForm_{student.UserId}_{student.CourseId}";


                            <tr>

                                <td>

                                    <strong>
                                        @student.StudentId
                                    </strong>

                                </td>


                                <td>
                                    @student.Username
                                </td>


                                <td>
                                    @student.ProgramName
                                </td>


                                <td>

                                    <div class="subject-cell">

                                        @if (
                                            !string.IsNullOrWhiteSpace(
                                                student.CourseCode
                                            )
                                        )
                                        {
                                            <strong>
                                                @student.CourseCode
                                            </strong>
                                        }

                                        <span>
                                            @student.CourseName
                                        </span>

                                    </div>

                                </td>


                                <td>

                                    <span class="absent-badge">
                                        @student.AbsentCount
                                    </span>

                                </td>


                                <td>

                                    <span class="attendance-badge danger">

                                        @percentage.ToString("0.#")%

                                    </span>

                                </td>


                                <td>

                                    <input type="text"
                                           name="reason"
                                           form="@formId"
                                           maxlength="300"
                                           placeholder="Enter reason"
                                           required />

                                </td>


                                <td>

                                    <form asp-controller="Admin"
                                          asp-action="AddBarredStudent"
                                          method="post"
                                          id="@formId">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="userId"
                                               value="@student.UserId" />


                                        <input type="hidden"
                                               name="courseId"
                                               value="@student.CourseId" />


                                        <button type="submit"
                                                class="add-button"
                                                onclick="return confirm('Add this student to the barred list?');">

                                            + Add

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- ==================================
                 ELIGIBLE PAGINATION
                 ================================== -->
            @if (
                            eligibleTotalPages >
                            1
                        )
            {
                <div class="pagination-wrapper">

                    <span class="page-info">

                        Page
                        @eligiblePage
                        of
                        @eligibleTotalPages

                    </span>


                    <div class="pagination">


                        @if (
                            eligiblePage >
                            1
                        )
                        {
                            <a asp-controller="Admin"
                               asp-action="BarredList"
                               asp-route-barredPage="@barredPage"
                               asp-route-eligiblePage="@(eligiblePage - 1)"
                               class="page-button">

                                ← Previous

                            </a>
                        }
                        else
                        {
                            <span class="page-button disabled">
                                ← Previous
                            </span>
                        }


                        @for (
                            int i = 1;
                            i <= eligibleTotalPages;
                            i++
                        )
                        {
                            <a asp-controller="Admin"
                               asp-action="BarredList"
                               asp-route-barredPage="@barredPage"
                               asp-route-eligiblePage="@i"
                               class="page-number @(i == eligiblePage ? "active" : "")">

                                @i

                            </a>
                        }


                        @if (
                            eligiblePage <
                            eligibleTotalPages
                        )
                        {
                            <a asp-controller="Admin"
                               asp-action="BarredList"
                               asp-route-barredPage="@barredPage"
                               asp-route-eligiblePage="@(eligiblePage + 1)"
                               class="page-button">

                                Next →

                            </a>
                        }
                        else
                        {
                            <span class="page-button disabled">
                                Next →
                            </span>
                        }

                    </div>

                </div>
            }

        }

    </section>

</div>