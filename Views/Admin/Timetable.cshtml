@{
    ViewData["Title"] = "Timetable Management";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/timetable.css" />

<div class="tt-page">
    <a asp-controller="Admin"
       asp-action="Index"
       class="tt-back-link">
        &larr; Back
    </a>

    <h2>Timetable Management</h2>

    <div class="tt-tabs">
        <button type="button" class="tt-tab active" data-classtype="School">School (Mon - Fri)</button>
        <button type="button" class="tt-tab" data-classtype="Tuition">Tuition (Sat - Sun)</button>
    </div>

    <div class="tt-toolbar">
        <label>
            Class:
            <select id="classFilter"></select>
        </label>
        <button type="button" id="manageLookupsBtn">Manage Courses / Classes / Classrooms</button>
    </div>

    <div class="tt-layout">
        <aside class="tt-teacher-panel">
            <h3>Teachers</h3>
            <p class="tt-hint">Drag a teacher onto a timetable cell</p>
            <ul id="teacherList" class="tt-teacher-list"></ul>
        </aside>

        <div class="tt-grid-wrapper">
            <table class="tt-grid" id="timetableGrid">
                <thead>
                    <tr id="gridHeaderRow"></tr>
                </thead>
                <tbody id="gridBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Assign / Edit lesson modal -->
<div id="lessonModal" class="tt-modal-overlay" style="display:none;">
    <div class="tt-modal">
        <h3 id="lessonModalTitle">Assign Lesson</h3>
        <div id="lessonModalError" class="tt-error" style="display:none;"></div>

        <form id="lessonForm">
            <input type="hidden" id="fTimetableId" />
            <input type="hidden" id="fTeacherId" />
            <input type="hidden" id="fDayOfWeek" />
            <input type="hidden" id="fClassType" />

            <label>Teacher</label>
            <input type="text" id="fTeacherName" disabled />

            <label>Course</label>
            <select id="fCourseId" required></select>

            <label>Class</label>
            <select id="fClassId" required></select>

            <label>Classroom (optional)</label>
            <select id="fClassroomId">
                <option value="">-- none --</option>
            </select>

            <div class="tt-time-row">
                <div>
                    <label>Start Time</label>
                    <input type="time" id="fStartTime" min="09:00" max="17:00" required />
                </div>
                <div>
                    <label>End Time</label>
                    <input type="time" id="fEndTime" min="09:00" max="17:00" required />
                </div>
            </div>

            <div class="tt-modal-actions">
                <button type="button" id="deleteLessonBtn" class="tt-btn-danger" style="display:none;">Delete</button>
                <button type="button" id="cancelLessonBtn" class="tt-btn-secondary">Cancel</button>
                <button type="submit" class="tt-btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Manage lookups (Course / Class / Classroom) modal -->
<div id="lookupModal" class="tt-modal-overlay" style="display:none;">
    <div class="tt-modal">
        <h3>Manage Courses / Classes / Classrooms</h3>
        <div class="tt-lookup-columns">
            <div>
                <h4>Courses</h4>
                <ul id="courseLookupList" class="tt-lookup-list"></ul>
                <div class="tt-lookup-add">
                    <input type="text" id="newCourseName" placeholder="New course name" />
                    <button type="button" data-add="course">Add</button>
                </div>
            </div>
            <div>
                <h4>Classes</h4>
                <ul id="classLookupList" class="tt-lookup-list"></ul>
                <div class="tt-lookup-add">
                    <input type="text" id="newClassName" placeholder="New class name" />
                    <button type="button" data-add="class">Add</button>
                </div>
            </div>
            <div>
                <h4>Classrooms</h4>
                <ul id="classroomLookupList" class="tt-lookup-list"></ul>
                <div class="tt-lookup-add">
                    <input type="text" id="newClassroomName" placeholder="New classroom name" />
                    <button type="button" data-add="classroom">Add</button>
                </div>
            </div>
        </div>
        <div class="tt-modal-actions">
            <button type="button" id="closeLookupModalBtn" class="tt-btn-secondary">Close</button>
        </div>
    </div>
</div>

<script src="~/js/timetable.js"></script>
