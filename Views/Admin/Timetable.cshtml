@{ ViewData["Title"]="Timetable Management"; Layout="_Layout"; }
<link rel="stylesheet" href="~/css/Timetable.css" asp-append-version="true" />
<div class="tt-page">
    <div class="tt-head">
        <div><h2>Timetable Management</h2><p>Academic scheduling for School and Tuition</p></div>
        <div class="tt-head-actions">
            <a asp-controller="Admin" asp-action="Index" class="tt-btn-secondary tt-back-home">← Back</a>
            <button id="newSemesterBtn" class="tt-btn-primary">New Semester</button>
            <button id="backProgram" class="tt-btn-secondary" hidden>← Programs</button>
            <button id="backDashboard" class="tt-btn-secondary" hidden>← Timetable Home</button>
        </div>
    </div>

    <section id="dashboardView">
        <div class="tt-status-tabs">
            <button class="active" data-status="current">Current / Upcoming</button>
            <button data-status="completed">Completed / History</button>
            <button data-status="holiday">Holiday Calendar</button>
            <button data-status="audit">Audit</button>
        </div>
        <div id="termCards"></div>

        <section id="auditPanel" class="tt-history-panel" hidden>
            <div class="tt-history-head">
                <div><h3>Timetable Audit</h3><p>Pending items require Admin action. Resolved items keep the before/after change history.</p></div>
                <select id="auditFilter"><option value="all">All</option><option value="pending">Pending</option><option value="resolved">Resolved</option></select>
            </div>
            <div id="auditSummary" class="tt-audit-summary"></div>
            <div id="auditList" class="tt-audit-list"></div>
        </section>

        <section id="holidayHistoryPanel" class="tt-history-panel" hidden>
            <div class="tt-history-head">
                <div><h3>Holiday Calendar</h3><p>Manage one central holiday calendar. Holidays automatically apply to any semester whose date range includes the holiday.</p></div>
            </div>
            <div id="holidayError" class="tt-error" hidden></div>
            <div class="tt-holiday-tools">
                <form id="holidayForm" class="tt-holiday-form">
                    <div class="tt-holiday-input-row">
                        <label>Date<input id="holidayDate" type="date" required></label>
                        <label>Holiday name<input id="holidayName" maxlength="150" placeholder="e.g. National Day" required></label>
                        <label>Type<select id="holidayType"><option value="PublicHoliday">Public Holiday</option><option value="UniversityHoliday">University Holiday</option><option value="Closure">Closure</option></select></label>
                    </div>
                    <div class="tt-holiday-action-row">
                        <button class="tt-btn-primary" type="submit">Add Holiday</button>
                        <button class="tt-btn-secondary" type="button" id="loadMalaysiaHolidaysBtn">Load Malaysia 2026</button>
                    </div>
                </form>
                <div id="holidayDropZone" class="tt-drop-zone" tabindex="0">
                    <strong>Drop holiday .txt / .csv here</strong>
                    <span>CSV: YYYY-MM-DD,Holiday Name,Type · TXT: YYYY-MM-DD | Holiday Name | Type</span>
                    <input id="holidayFile" type="file" accept=".txt,.csv,text/plain,text/csv" hidden>
                    <button type="button" class="tt-btn-secondary" id="chooseHolidayFile">Choose File</button>
                </div>
            </div>
            <div id="holidayImportResult" class="tt-import-result" hidden></div>
            <div class="tt-holiday-list-header"><strong>Date</strong><strong>Holiday</strong><strong>Type</strong><span></span></div>
            <div id="holidayList" class="tt-holiday-list"></div>
        </section>
    </section>

    <section id="programView" hidden>
        <div class="tt-breadcrumb" id="programBreadcrumb"></div>
        <div id="programClassCards" class="tt-class-cards"></div>
    </section>

    <section id="workspaceView" hidden>
        <div class="tt-context">
            <div><strong id="ctxTerm"></strong> <span id="ctxStatus" class="tt-inline-status"></span><br><span id="ctxProgram"></span> · <span id="ctxClass"></span></div>
            <div class="tt-context-actions">
                <button id="schoolBtn" class="active">School</button><button id="tuitionBtn">Tuition</button>
                <button id="viewBtn" class="active">View</button><button id="editBtn">Edit</button>
                <select id="weekDate"><option value="">Weekly template</option></select>
            </div>
        </div>
        <div id="weekNotice" class="tt-week-notice" hidden></div>
        <section id="replacementPanel" class="tt-replacement-panel" hidden>
            <div class="tt-replacement-head"><div><strong>Replacement Required</strong><span>Current-Week cancellations are shown first, followed by older unresolved items. Schedule them into an available Tuition slot. If no valid weekend remains, Admin can confirm that the cancelled lesson will not have a replacement class.</span></div></div>
            <div id="replacementRequiredList" class="tt-replacement-list"></div>
        </section>
        <div class="tt-legend"><span class="normal">● Normal</span><span class="attention">● Attention / Conflict / Holiday</span><span class="cancelled">● Cancelled</span></div>
        <div class="tt-layout">
            <aside id="assignmentPanel" class="tt-teacher-panel" hidden>
                <h3>Teacher · Subject</h3><p class="tt-hint">Drag a registered teacher/subject assignment to an hourly cell.</p>
                <input id="assignmentSearch" placeholder="Search teacher or subject..."/><ul id="assignmentList" class="tt-teacher-list"></ul>
            </aside>
            <div class="tt-grid-wrapper"><table class="tt-grid"><thead><tr id="gridHeaderRow"></tr></thead><tbody id="gridBody"></tbody></table></div>
        </div>
        <div class="tt-footer-actions"><button id="exportPdf">PDF</button><button id="exportExcel">Excel</button><button id="exportCsv">CSV</button></div>
    </section>
</div>

<div id="lessonModal" class="tt-modal-overlay" hidden>
    <div class="tt-modal">
        <h3 id="lessonModalTitle">Lesson</h3><div id="lessonModalError" class="tt-error" hidden></div>
        <form id="lessonForm">
            <input type="hidden" id="fTimetableId"><input type="hidden" id="fTeacherId"><input type="hidden" id="fCourseId"><input type="hidden" id="fDayOfWeek">
            <label>Teacher · Subject</label><input id="fAssignment" disabled>
            <label>Classroom</label><select id="fClassroomId"></select><div id="roomHint" class="tt-form-hint"></div>
            <label>Time</label><div class="tt-time-row"><input type="time" id="fStartTime" readonly><input type="time" id="fEndTime" readonly></div>
            <label>Status <small id="statusDateLabel"></small></label>
            <select id="fStatus"><option value="Normal">Normal</option><option value="Cancelled">Cancelled</option></select>
            <div id="statusHint" class="tt-form-hint"></div>
            <div class="tt-modal-actions"><button type="button" id="deleteLessonBtn" class="tt-btn-danger">Delete</button><button type="button" id="cancelLessonBtn" class="tt-btn-secondary">Close</button><button type="submit" class="tt-btn-primary">Save</button></div>
        </form>
    </div>
</div>

<div id="semesterModal" class="tt-modal-overlay" hidden>
    <div class="tt-modal">
        <div class="tt-modal-head"><h3 id="semesterModalTitle">Create New Semester</h3><button type="button" id="closeSemesterBtn" class="tt-icon-btn">×</button></div>
        <div id="semesterError" class="tt-error" hidden></div>
        <form id="semesterForm">
            <input type="hidden" id="semesterTermId">
            <div class="tt-semester-row">
                <label>Semester name<input id="semesterName" maxlength="100" placeholder="e.g. Semester 3 2026" required></label>
                <label>Start date<input id="semesterStart" type="date" required></label>
                <label>End date<input id="semesterEnd" type="date" required></label>
            </div>
            <div class="tt-form-hint">New semesters are created as Incoming. Only Incoming semester dates can be edited. Active semester dates are locked. Semester dates cannot overlap, including sharing the same boundary date.</div>
            <div id="forceActiveConfirm" class="tt-force-active" hidden>
                <div class="tt-force-active-icon">!</div>
                <div>
                    <strong>Starts today — Active confirmation required</strong>
                    <p id="forceActiveMessage">This semester starts today. Creating it will make the semester Active immediately.</p>
                    <small>Only one Active semester can exist at a time. The semester dates will be locked after activation.</small>
                </div>
                <div class="tt-force-active-actions">
                    <button type="button" id="cancelForceActiveBtn" class="tt-btn-secondary">Go Back</button>
                    <button type="button" id="confirmForceActiveBtn" class="tt-btn-danger-confirm">Create as Active</button>
                </div>
            </div>
            <div class="tt-modal-actions"><button type="button" id="cancelSemesterBtn" class="tt-btn-secondary">Cancel</button><button type="submit" id="semesterSubmitBtn" class="tt-btn-primary">Create</button></div>
        </form>
    </div>
</div>

<div id="replacementModal" class="tt-modal-overlay" hidden>
    <div class="tt-modal">
        <h3>Schedule replacement class</h3><div id="replacementError" class="tt-error" hidden></div>
        <form id="replacementForm">
            <input type="hidden" id="rTimetableId"><input type="hidden" id="rSourceDate"><input type="hidden" id="rTeacherId">
            <label>Cancelled lesson</label><input id="rOriginal" disabled>
            <label>Replacement date</label><input id="rDate" type="date" required>
            <label>Time</label><div class="tt-time-row"><input type="time" id="rStart" required><input type="time" id="rEnd" required></div>
            <label>Classroom</label><select id="rClassroom"></select><div id="replacementRoomHint" class="tt-form-hint"></div>
            <div class="tt-form-hint">Replacement must be on or after the cancelled lesson date, within the same semester, and in the Tuition timetable (Saturday/Sunday). Daily/consecutive Tuition-hour limits are ignored, but teacher, class, classroom and time conflicts are still blocked.</div>
            <div class="tt-modal-actions"><button type="button" id="closeReplacementBtn" class="tt-btn-secondary">Close</button><button type="submit" class="tt-btn-primary">Schedule Replacement</button></div>
        </form>
    </div>
</div>

<script src="~/js/timetable.js" asp-append-version="true"></script>
