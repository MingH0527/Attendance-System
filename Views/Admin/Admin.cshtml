@{
    ViewData["Title"] = "Admin Home";
}

<link rel="stylesheet"
      href="~/css/student.css"
      asp-append-version="true" />

<div class="student-home-page">

    <main class="student-home-container">

        <div class="student-home-card">

            <div class="student-icon">
                <span>🛠️</span>
            </div>

            <p class="system-name">
                Attendance System
            </p>

            <h1>Admin Home</h1>

            <p class="welcome-text">
                Welcome to your administrator account.
            </p>

            <div class="student-actions">

                <!-- My Profile -->
                <a asp-controller="MyProfile"
                   asp-action="Index"
                   class="student-button profile-button">

                    <span class="button-icon">
                        👤
                    </span>

                    <span class="button-content">
                        <strong>My Profile</strong>

                        <small>
                            Manage your account and security
                        </small>
                    </span>

                    <span class="button-arrow">
                        ›
                    </span>

                </a>

                <!-- Logout -->
                <form asp-controller="Admin"
                      asp-action="Logout"
                      method="post"
                      class="logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="student-button logout-button">

                        <span class="button-icon">
                            ↪
                        </span>

                        <span class="button-content">
                            <strong>Logout</strong>

                            <small>
                                Sign out from your account
                            </small>
                        </span>

                        <span class="button-arrow">
                            ›
                        </span>

                    </button>

                </form>

            </div>

        </div>

    </main>

</div>