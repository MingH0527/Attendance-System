@{
    ViewData["Title"] = "Payment Cancelled";

    int feeId =
        ViewBag.FeeId ?? 0;
}

<link rel="stylesheet"
      href="~/css/face-payment.css"
      asp-append-version="true" />

<div class="payment-cancel-page">

    <div class="payment-cancel-card">

        <div class="payment-cancel-icon">
            ×
        </div>

        <p class="payment-cancel-eyebrow">
            PAYMENT STATUS
        </p>

        <h1>
            Payment Cancelled
        </h1>

        <p class="payment-cancel-message">
            No payment was charged.
            You can try the payment again or return to the fee list.
        </p>


        <div class="payment-cancel-actions">

            @if (feeId > 0)
            {
                <a asp-controller="Payment"
                   asp-action="Pay"
                   asp-route-feeId="@feeId"
                   class="cancel-button primary">

                    Try Again

                </a>
            }


            <a asp-controller="Payment"
               asp-action="SelectFee"
               class="cancel-button secondary">

                ← Back to Fees

            </a>

        </div>

    </div>

</div>