@model WebAndMobile.Models.FeeItem

@{
    ViewData["Title"] = "Student Payment";
}

<link rel="stylesheet" href="~/css/Payment.css" />

<div class="payment-page">
    <div class="payment-container">

        <h1>Student Payment</h1>

        <p>
            Complete your payment securely through Stripe.
        </p>

        <div class="payment-details">
            <p>
                Payment item
                <strong>@Model.Name</strong>
            </p>

            <p>
                Amount
                <strong>RM @Model.Amount.ToString("N2")</strong>
            </p>
        </div>

        <form asp-controller="Payment"
              asp-action="CreateCheckoutSession"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="feeId"
                   value="@Model.Id" />

            <button type="submit"
                    class="payment-button">
                Pay RM @Model.Amount.ToString("N2")
            </button>
        </form>

    </div>
</div>