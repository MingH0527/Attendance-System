@model List<WebAndMobile.Models.UserPasskey>

@{
    ViewData["Title"] = "Manage Passkeys";

    int passkeyCount =
        ViewBag.PasskeyCount ?? 0;

    int maximumPasskeys =
        ViewBag.MaximumPasskeys ?? 3;

    bool limitReached =
        passkeyCount >= maximumPasskeys;

    bool isAdmin =
        ViewBag.IsAdmin ?? false;

    bool adminPinEnabled =
        ViewBag.AdminPinEnabled ?? false;

    string passkeyEnvironment =
        ViewBag.PasskeyEnvironment ?? "Unknown";

    string passkeyRpId =
        ViewBag.PasskeyRpId ?? "Unknown";
}

<link rel="stylesheet"
      href="~/css/passkey.css"
      asp-append-version="true" />

<div class="passkey-page">

    <main class="passkey-container">

        <div class="passkey-card">

            <div class="passkey-header">

                @{
                    // Passkey is reachable from the admin dashboard, the
                    // teacher dashboard and My Profile, so "back" cannot be
                    // a fixed destination. IsLocalUrl blocks an off-site
                    // redirect being passed in the query string.
                    string? passkeyReturn = Context.Request.Query["returnUrl"];

                    string passkeyBackUrl =
                        !string.IsNullOrWhiteSpace(passkeyReturn) &&
                        Url.IsLocalUrl(passkeyReturn)
                            ? passkeyReturn!
                            : Url.Action("Index", "MyProfile")!;
                }

                <a href="@passkeyBackUrl"
                   class="back-button"
                   title="Back">
                    ←
                </a>

                <div class="passkey-icon">
                    🔐
                </div>

                <p class="system-name">
                    Security
                </p>

                <h1>Manage Passkeys</h1>

                <p class="passkey-description">
                    Use fingerprint, Face ID or your
                    device screen lock to securely
                    access your account.
                </p>

            </div>

            @if (ViewBag.Error != null)
            {
                <div class="passkey-message error">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Message != null)
            {
                <div class="passkey-message success">
                    @ViewBag.Message
                </div>
            }

            <div id="passkeyMessage"
                 class="passkey-message"
                 hidden>
            </div>

            @if (isAdmin)
            {
                <div class="admin-security-box">

                    <div>
                        <strong>
                            Admin Security PIN
                        </strong>

                        @if (adminPinEnabled)
                        {
                            <p class="pin-enabled">
                                Enabled
                            </p>
                        }
                        else
                        {
                            <p class="pin-not-enabled">
                                Not configured
                            </p>
                        }
                    </div>

                    <a asp-controller="MyProfile"
                       asp-action="SetAdminPin"
                       class="admin-pin-button">

                        @(adminPinEnabled
                            ? "Update PIN"
                            : "Set PIN")

                    </a>

                </div>
            }

            <div class="passkey-information">

                <div class="information-row">

                    <span class="information-icon">
                        🛡️
                    </span>

                    <div>
                        <strong>
                            Your biometric information
                            stays on your device
                        </strong>

                        <p>
                            This website only stores
                            your passkey public credential.
                            It does not receive your
                            fingerprint or facial data.
                        </p>
                    </div>

                </div>

            </div>

            <div class="passkey-environment-box">
                <div>
                    <span class="limit-label">
                        Passkey environment
                    </span>
                    <strong>
                        @passkeyEnvironment
                    </strong>
                </div>

                <small>
                    RP ID: @passkeyRpId
                </small>
            </div>

            <div class="passkey-limit">

                <div>

                    <span class="limit-label">
                        Registered passkeys
                    </span>

                    <strong class="limit-number"
                            id="passkeyCount">

                        @passkeyCount /
                        @maximumPasskeys

                    </strong>

                </div>

                <span class="limit-status"
                      id="passkeyStatus">

                    @(limitReached
                        ? "Full"
                        : "Available")

                </span>

            </div>

            <div id="passkeyList">

                @if (Model == null ||
                     Model.Count == 0)
                {
                    <div class="empty-passkey-list"
                         id="emptyPasskeyList">

                        <div class="empty-icon">
                            📱
                        </div>

                        <h2>
                            No passkeys registered
                        </h2>

                        <p>
                            Register your phone,
                            tablet or computer as a
                            trusted login device.
                        </p>

                    </div>
                }
                else
                {
                    <div class="registered-passkey-list">

                        @foreach (var passkey in Model)
                        {
                            <div class="registered-passkey-item"
                                 id="passkey-@passkey.UserPasskeyId">

                                <span class="registered-passkey-icon">
                                    🔑
                                </span>

                                <div class="registered-passkey-content">

                                    @{
                                        string attachment =
                                            passkey.AuthenticatorAttachment ?? "";

                                        string transports =
                                            passkey.AuthenticatorTransports ?? "";

                                        bool isPlatform =
                                            attachment.Equals(
                                                "platform",
                                                StringComparison.OrdinalIgnoreCase);

                                        bool isCrossPlatform =
                                            attachment.Equals(
                                                "cross-platform",
                                                StringComparison.OrdinalIgnoreCase);

                                        bool isHybrid =
                                            transports.Contains(
                                                "hybrid",
                                                StringComparison.OrdinalIgnoreCase);

                                        string authenticatorName =
                                            isHybrid
                                                ? "Phone / External Device"
                                                : isPlatform
                                                    ? "This Device"
                                                    : isCrossPlatform
                                                        ? "External Authenticator"
                                                        : "Passkey Authenticator";

                                        string authenticatorDetails =
                                            isPlatform
                                                ? "Platform"
                                                : isCrossPlatform && isHybrid
                                                    ? "Cross-platform · Hybrid"
                                                    : isCrossPlatform
                                                        ? "Cross-platform"
                                                        : !string.IsNullOrWhiteSpace(transports)
                                                            ? transports
                                                            : "Unknown";
                                    }

                                    <strong>
                                        @authenticatorName
                                    </strong>

                                    <small>
                                        <b>Authenticator:</b>
                                        @authenticatorDetails
                                    </small>

                                    <small>
                                        <b>Registered from:</b>
                                        @passkey.DeviceName
                                        @if (!string.IsNullOrWhiteSpace(
                                                passkey.DeviceType))
                                        {
                                            <text>
                                                · @passkey.DeviceType
                                            </text>
                                        }
                                    </small>

                                    @if (!string.IsNullOrWhiteSpace(
                                            passkey.OperatingSystem) ||
                                         !string.IsNullOrWhiteSpace(
                                            passkey.Browser))
                                    {
                                        <small>
                                            @if (!string.IsNullOrWhiteSpace(
                                                    passkey.OperatingSystem))
                                            {
                                                <text>
                                                    @passkey.OperatingSystem
                                                </text>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(
                                                    passkey.Browser))
                                            {
                                                <text>
                                                    · @passkey.Browser
                                                </text>
                                            }
                                        </small>
                                    }

                                    <small>
                                        Registered
                                        @(passkey.CreatedAt
                                            .ToLocalTime()
                                            .ToString(
                                                "dd MMM yyyy, hh:mm tt"))
                                    </small>

                                    @if (passkey.LastUsedAt.HasValue)
                                    {
                                        <small>
                                            Last used
                                            @(passkey.LastUsedAt.Value
                                                .ToLocalTime()
                                                .ToString(
                                                    "dd MMM yyyy, hh:mm tt"))
                                        </small>
                                    }

                                </div>

                                <button type="button"
                                        class="delete-passkey-button"
                                        data-passkey-id="@passkey.UserPasskeyId"
                                        data-device-name="@passkey.DeviceName"
                                        data-is-last="@(Model.Count == 1 ? "true" : "false")"
                                        data-is-admin="@(isAdmin ? "true" : "false")">

                                    Delete

                                </button>

                            </div>
                        }

                    </div>
                }

            </div>

            <form id="passkeyTokenForm">
                @Html.AntiForgeryToken()
            </form>

            <button type="button"
                    id="registerPasskeyButton"
                    class="register-passkey-button"
                    disabled="@limitReached">

                <span>＋</span>

                <span id="registerButtonText">
                    @(limitReached
                        ? "Maximum Passkeys Reached"
                        : "Register Passkey")
                </span>

            </button>

            <p class="development-message">
                Maximum 3 passkeys per account ·
                Maximum 4 accounts per verified phone/tablet device.
            </p>

            <p class="delete-note">
                Deleting a passkey here removes it
                from this website. You may also need
                to remove it from your phone or
                password manager separately.
            </p>

            <div id="deviceBindingModal"
                 hidden
                 style="position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:9999;padding:24px;overflow:auto;">

                <div style="max-width:520px;margin:40px auto;background:white;border-radius:24px;padding:28px;text-align:center;">
                    <h2>Verify the phone or tablet</h2>

                    <p>
                        Scan this QR code using the phone or tablet that will own
                        the Passkey. This check is only required during registration.
                    </p>

                    <img id="deviceBindingQr"
                         alt="Device binding QR code"
                         style="width:260px;height:260px;max-width:100%;object-fit:contain;" />

                    <p id="deviceBindingStatus">
                        Waiting for device verification...
                    </p>
<button type="button"
                            id="cancelDeviceBindingButton">
                        Cancel
                    </button>
                </div>

            </div>

        </div>

    </main>

</div>



@section Scripts {

}
<script src="~/js/passkey.js"></script>
