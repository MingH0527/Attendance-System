@using System.Security.Claims

@{
    Layout = "_Layout";
    ViewData["Title"] = "My Profile";

    string username =
        User.Identity?.Name ??
        "User";

    string role =
        User.FindFirstValue(
            ClaimTypes.Role
        ) ?? "User";

    string email =
        User.FindFirstValue(
            ClaimTypes.Email
        ) ?? "Not available";

    string homeController =
        role switch
        {
            "Admin" => "Admin",
            "Teacher" => "Teacher",
            _ => "Student"
        };
}

<link rel="stylesheet"
      href="~/css/myprofile.css"
      asp-append-version="true" />

<div class="profile-page">

    @if (
        TempData["ProfileRequired"] != null
    )
    {
        <div class="profile-required-alert">
            ⚠️ @TempData["ProfileRequired"]
        </div>
    }


    <div class="profile-container">

        <!-- ==========================================
     PROFILE HEADER
=========================================== -->

        <div class="profile-header">

            <!-- Avatar -->
            <div class="profile-avatar-wrapper">

                @{
                    string? storedAvatar =
                        ViewBag.Avatar as string;

                    bool hasCustomAvatar =
                        !string.IsNullOrWhiteSpace(storedAvatar) &&
                        storedAvatar != "default.png" &&
                        storedAvatar != "default-avatar.png";

                    string firstLetter =
                        !string.IsNullOrWhiteSpace(username)
                            ? username.Substring(0, 1).ToUpper()
                            : "U";
                }


                <!-- Default letter -->
                <div class="profile-avatar-default">
                    @firstLetter
                </div>


                <!-- Uploaded avatar -->
                @if (hasCustomAvatar)
                {
                    string avatarUrl =
                        storedAvatar!.StartsWith("/") ||
                        storedAvatar.StartsWith("http://") ||
                        storedAvatar.StartsWith("https://")
                            ? storedAvatar
                            : $"/uploads/avatars/{storedAvatar}";

                    <img src="@avatarUrl"
                         class="profile-avatar-image"
                         alt="@username"
                         onerror="this.style.display='none';" />
                }


                <!-- Edit button -->
                <button type="button"
                        class="avatar-edit-button"
                        title="Change profile picture"
                        onclick="document.getElementById('avatarInput').click()">

                    ✎

                </button>


                <!-- Upload form -->
                <form asp-controller="MyProfile"
                      asp-action="UploadAvatar"
                      method="post"
                      enctype="multipart/form-data"
                      id="avatarForm">

                    @Html.AntiForgeryToken()

                    <input type="file"
                           id="avatarInput"
                           name="avatar"
                           accept=".jpg,.jpeg,.png,.webp"
                           hidden
                           onchange="document.getElementById('avatarForm').submit()" />

                </form>

            </div>


            <!-- Username -->
            <h1 class="profile-username">
                @username
            </h1>


            <!-- Role -->
            <span class="profile-role-badge">
                @role
            </span>

        </div>


        <!-- ==============================
             PROFILE INFORMATION
             ============================== -->

        <div class="profile-information">

            <!-- Username -->

            <div class="information-row">

                <span>
                    Username
                </span>

                <strong>
                    @username
                </strong>

            </div>


            <!-- Email -->

            <div class="information-row">

                <span>
                    Email
                </span>

                <strong>
                    @email
                </strong>

            </div>


            <!-- Role -->

            <div class="information-row">

                <span>
                    Role
                </span>

                <strong>
                    @role
                </strong>

            </div>


            <!-- ==============================
                 STUDENT INFORMATION
                 ============================== -->
            @if (
                            role ==
                            "Student"
                        )
            {
                <div class="information-row">

                    <span>
                        Student ID
                    </span>

                    <strong>
                        @(ViewBag.StudentId ?? "Not registered")
                    </strong>

                </div>


                <div class="information-row">

                    <span>
                        Program
                    </span>

                    <strong>
                        @(ViewBag.ProgramName ?? "Not registered")
                    </strong>

                </div>


                <div class="information-row">

                    <span>
                        Class
                    </span>

                    <strong>
                        @(ViewBag.ClassName ?? "Not registered")
                    </strong>

                </div>
            }


            <!-- ==============================
                 TEACHER INFORMATION
                 ============================== -->
            @if (
                            role ==
                            "Teacher"
                        )
            {
                <!-- Program -->

                <div class="information-row">

                    <span>
                        Program
                    </span>


                    <div class="information-value">

                        @if (
                            !string.IsNullOrWhiteSpace(
                                ViewBag.ProgramName as string
                            )
                        )
                        {
                            foreach (
                                string program
                                in (
                                    ViewBag.ProgramName
                                    as string
                                    ?? ""
                                )
                                .Split(
                                    '\n',
                                    StringSplitOptions.RemoveEmptyEntries
                                )
                            )
                            {
                                <span class="profile-value-line">
                                    @program.Trim()
                                </span>
                            }
                        }
                        else
                        {
                            <strong>
                                Not registered
                            </strong>
                        }

                    </div>

                </div>


                <!-- Subject -->

                <div class="information-row">

                    <span>
                        Subject
                    </span>


                    <div class="information-value">

                        @if (
                            !string.IsNullOrWhiteSpace(
                                ViewBag.SubjectName as string
                            )
                        )
                        {
                            foreach (
                                string subject
                                in (
                                    ViewBag.SubjectName
                                    as string
                                    ?? ""
                                )
                                .Split(
                                    '\n',
                                    StringSplitOptions.RemoveEmptyEntries
                                )
                            )
                            {
                                <span class="profile-value-line">
                                    @subject.Trim()
                                </span>
                            }
                        }
                        else
                        {
                            <strong>
                                Not registered
                            </strong>
                        }

                    </div>

                </div>
            }

        </div>


        <!-- ==============================
             PROFILE ACTIONS
             ============================== -->

        <div class="profile-actions">


            <!-- ==============================
                 COMPLETE PROFILE
                 ============================== -->
            @if (
                            ViewBag.ShowRegisterCourseCard ==
                            true
                        )
            {
                @if (
                    role ==
                    "Teacher"
                )
                {
                    <a asp-controller="Teacher"
                       asp-action="Create"
                       class="profile-button security">

                        <span>
                            📋
                        </span>

                        <div>

                            <strong>
                                Complete My Profile
                            </strong>

                            <small>
                                Register your program and
                                the subject(s) you teach.
                            </small>

                        </div>

                    </a>
                }
                else if (
                    role ==
                    "Student"
                )
                {
                    <a asp-controller="Program"
                       asp-action="RegisterProgram"
                       class="profile-button security">

                        <span>
                            📋
                        </span>

                        <div>

                            <strong>
                                Complete My Profile
                            </strong>

                            <small>
                                Register your program and
                                class to finish setup.
                            </small>

                        </div>

                    </a>
                }
            }


            <!-- ==============================
                 STUDENT FACE ID
                 ============================== -->
            @if (
                            role ==
                            "Student"
                        )
            {
                <a asp-controller="FaceId"
                   asp-action="Manage"
                   class="profile-button security">

                    <span>
                        🙂
                    </span>

                    <div>

                        <strong>
                            Payment Face ID
                        </strong>

                        <small>
                            Register the face used
                            before QR payment.
                        </small>

                    </div>

                </a>
            }


            <!-- ==============================
                 PASSKEY
                 ============================== -->

            <a asp-controller="MyProfile"
               asp-action="Passkey"
               class="profile-button primary">

                <span>
                    🔐
                </span>

                <div>

                    <strong>
                        Passkey Management
                    </strong>

                    <small>
                        Register and manage
                        secure login devices.
                    </small>

                </div>

            </a>


            <!-- ==============================
                 ADMIN PIN
                 ============================== -->
            @if (
                            role ==
                            "Admin"
                        )
            {
                <a asp-controller="MyProfile"
                   asp-action="SetAdminPin"
                   class="profile-button security">

                    <span>
                        🔢
                    </span>

                    <div>

                        <strong>
                            Admin Security PIN
                        </strong>

                        <small>
                            Create or update your
                            six-digit Admin PIN.
                        </small>

                    </div>

                </a>
            }


            <!-- ==============================
                 BACK HOME
                 ============================== -->

            <a asp-controller="@homeController"
               asp-action="Index"
               class="profile-button secondary">

                <span>
                    🏠
                </span>

                <div>

                    <strong>
                        Back to Home
                    </strong>

                    <small>
                        Return to your dashboard.
                    </small>

                </div>

            </a>

        </div>

    </div>

</div>

@if (TempData["AvatarSuccess"] != null)
{
    <div id="avatarToast"
         class="avatar-toast avatar-toast-success">

        <span class="avatar-toast-icon">✓</span>

        <div>
            <strong>Success</strong>
            <p>@TempData["AvatarSuccess"]</p>
        </div>

        <button type="button"
                onclick="closeAvatarToast()">
            ×
        </button>

    </div>
}

@if (TempData["AvatarError"] != null)
{
    <div id="avatarToast"
         class="avatar-toast avatar-toast-error">

        <span class="avatar-toast-icon">!</span>

        <div>
            <strong>Upload Failed</strong>
            <p>@TempData["AvatarError"]</p>
        </div>

        <button type="button"
                onclick="closeAvatarToast()">
            ×
        </button>

    </div>
}

<script>
    function closeAvatarToast() {

        const toast =
            document.getElementById("avatarToast");

        if (toast) {

            toast.classList.add(
                "avatar-toast-hide"
            );

            setTimeout(
                () => toast.remove(),
                300
            );
        }
    }

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const toast =
                document.getElementById(
                    "avatarToast"
                );

            if (toast) {

                setTimeout(
                    closeAvatarToast,
                    3500
                );
            }
        }
    );
</script>