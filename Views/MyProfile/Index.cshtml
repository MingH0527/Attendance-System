@using System.Security.Claims

@{
    Layout = "_Layout";
    ViewData["Title"] = "My Profile";

    string username =
        User.Identity?.Name ??
        "User";

    string role =
        User.FindFirstValue(
            ClaimTypes.Role
        ) ?? "User";

    string email =
        User.FindFirstValue(
            ClaimTypes.Email
        ) ?? "Not available";

    string homeController =
        role switch
        {
            "Admin" => "Admin",
            "Teacher" => "Teacher",
            _ => "Student"
        };
}

<link rel="stylesheet" href="~/css/myprofile.css" />

<div class="profile-page">

    <div class="profile-container">

        <!-- Profile Header -->
        <div class="profile-header">

            <div class="profile-avatar">
                @username.Substring(0, 1).ToUpper()
            </div>

            <div>
                <p class="profile-label">
                    My Profile
                </p>

                <h1>@username</h1>

                <span class="role-badge">
                    @role
                </span>
            </div>

        </div>


        <!-- Profile Information -->
        <div class="profile-information">

            <div class="information-row">
                <span>Username</span>
                <strong>@username</strong>
            </div>

            <div class="information-row">
                <span>Email</span>
                <strong>@email</strong>
            </div>

            <div class="information-row">
                <span>Role</span>
                <strong>@role</strong>
            </div>

            <div class="information-row">
                <span>Student ID</span>
                <strong>
                    @(ViewBag.StudentId ?? "Not registered")
                </strong>
            </div>

            <div class="information-row">
                <span>Program</span>
                <strong>
                    @(ViewBag.ProgramName ?? "Not registered")
                </strong>
            </div>

            <div class="information-row">
                <span>Class</span>
                <strong>
                    @(ViewBag.ClassName ?? "Not registered")
                </strong>
            </div>

        </div>


        <!-- Profile Actions -->
        <div class="profile-actions">

            @if (ViewBag.ShowRegisterCourseCard == true)
            {
                <a asp-controller="Program"
                   asp-action="RegisterProgram"
                   class="profile-button security">

                    <span>📋</span>

                    <div>
                        <strong>
                            Complete My Profile
                        </strong>

                        <small>
                            @(role == "Teacher"
                                ? "Register the course(s) you teach."
                                : "Register your program and class to finish setup.")
                        </small>
                    </div>

                </a>
            }


            @if (role == "Student")
            {
                <a asp-controller="FaceId"
                   asp-action="Manage"
                   class="profile-button security">

                    <span>🙂</span>

                    <div>
                        <strong>
                            Payment Face ID
                        </strong>

                        <small>
                            Register the face used before QR payment.
                        </small>
                    </div>

                </a>
            }


            <a asp-controller="MyProfile"
               asp-action="Passkey"
               class="profile-button primary">

                <span>🔐</span>

                <div>
                    <strong>
                        Passkey Management
                    </strong>

                    <small>
                        Register and manage
                        secure login devices.
                    </small>
                </div>

            </a>


            @if (role == "Admin")
            {
                <a asp-controller="MyProfile"
                   asp-action="SetAdminPin"
                   class="profile-button security">

                    <span>🔢</span>

                    <div>
                        <strong>
                            Admin Security PIN
                        </strong>

                        <small>
                            Create or update your
                            six-digit Admin PIN.
                        </small>
                    </div>

                </a>
            }


            <a asp-controller="@homeController"
               asp-action="Index"
               class="profile-button secondary">

                <span>🏠</span>

                <div>
                    <strong>
                        Back to Home
                    </strong>

                    <small>
                        Return to your dashboard.
                    </small>
                </div>

            </a>

        </div>

    </div>

</div>