@using System.Security.Claims

@{
    Layout = "_Layout";
    ViewData["Title"] = "My Profile";

    string username =
        User.Identity?.Name ??
        "User";

    string role =
        User.FindFirstValue(
            ClaimTypes.Role
        ) ?? "User";

    string email =
        User.FindFirstValue(
            ClaimTypes.Email
        ) ?? "Not available";

    string homeController =
        role switch
        {
            "Admin" => "Admin",
            "Teacher" => "Teacher",
            _ => "Student"
        };
}

<link rel="stylesheet"
      href="~/css/myprofile.css"
      asp-append-version="true" />

<div class="profile-page">

    <div class="profile-container">

        <!-- Profile Header -->
        <div class="profile-header">

            <div class="profile-avatar-wrapper">

                @if (!string.IsNullOrWhiteSpace(ViewBag.Avatar as string) &&
                     ViewBag.Avatar != "default.png")
                {
                    <img src="@ViewBag.Avatar"
                         class="profile-avatar-image"
                         alt="Profile Picture" />
                }
                else
                {
                    <div class="profile-avatar-default">
                        @username.Substring(0, 1).ToUpper()
                    </div>
                }

                <button type="button"
                        class="avatar-edit-button"
                        title="Change profile picture"
                        onclick="document.getElementById('avatarInput').click()">
                    ✎
                </button>

                <form asp-controller="MyProfile"
                      asp-action="UploadAvatar"
                      method="post"
                      enctype="multipart/form-data"
                      id="avatarForm">

                    @Html.AntiForgeryToken()

                    <input type="file"
                           id="avatarInput"
                           name="avatar"
                           accept=".jpg,.jpeg,.png,.webp"
                           hidden
                           onchange="document.getElementById('avatarForm').submit()" />
                </form>

            </div>

            <h1 class="profile-username">
                @username
            </h1>

            <span class="role-badge">
                @role
            </span>

        </div>
            
    

        <!-- Profile Information -->
        <div class="profile-information">

            <div class="information-row">
                <span>Username</span>
                <strong>@username</strong>
            </div>

            <div class="information-row">
                <span>Email</span>
                <strong>@email</strong>
            </div>

            <div class="information-row">
                <span>Role</span>
                <strong>@role</strong>
            </div>

            <div class="information-row">
                <span>Student ID</span>
                <strong>
                    @(ViewBag.StudentId ?? "Not registered")
                </strong>
            </div>

            <div class="information-row">
                <span>Program</span>
                <strong>
                    @(ViewBag.ProgramName ?? "Not registered")
                </strong>
            </div>

            <div class="information-row">
                <span>Class</span>
                <strong>
                    @(ViewBag.ClassName ?? "Not registered")
                </strong>
            </div>

        </div>


        <!-- Profile Actions -->
        <div class="profile-actions">

            @if (ViewBag.ShowRegisterCourseCard == true)
            {
                <a asp-controller="Program"
                   asp-action="RegisterProgram"
                   class="profile-button security">

                    <span>📋</span>

                    <div>
                        <strong>
                            Complete My Profile
                        </strong>

                        <small>
                            @(role == "Teacher"
                                ? "Register the course(s) you teach."
                                : "Register your program and class to finish setup.")
                        </small>
                    </div>

                </a>
            }


            @if (role == "Student")
            {
                <a asp-controller="FaceId"
                   asp-action="Manage"
                   class="profile-button security">

                    <span>🙂</span>

                    <div>
                        <strong>
                            Payment Face ID
                        </strong>

                        <small>
                            Register the face used before QR payment.
                        </small>
                    </div>

                </a>
            }


            <a asp-controller="MyProfile"
               asp-action="Passkey"
               class="profile-button primary">

                <span>🔐</span>

                <div>
                    <strong>
                        Passkey Management
                    </strong>

                    <small>
                        Register and manage
                        secure login devices.
                    </small>
                </div>

            </a>


            @if (role == "Admin")
            {
                <a asp-controller="MyProfile"
                   asp-action="SetAdminPin"
                   class="profile-button security">

                    <span>🔢</span>

                    <div>
                        <strong>
                            Admin Security PIN
                        </strong>

                        <small>
                            Create or update your
                            six-digit Admin PIN.
                        </small>
                    </div>

                </a>
            }


            <a asp-controller="@homeController"
               asp-action="Index"
               class="profile-button secondary">

                <span>🏠</span>

                <div>
                    <strong>
                        Back to Home
                    </strong>

                    <small>
                        Return to your dashboard.
                    </small>
                </div>

            </a>

        </div>

    </div>

</div>