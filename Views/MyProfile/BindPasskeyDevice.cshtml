@{
    ViewData["Title"] = "Verify Passkey Device";
    string token = ViewBag.BindingToken ?? "";
    string? error = ViewBag.BindingError;
}

<div style="max-width:560px;margin:40px auto;padding:28px;border:1px solid #dbe4f0;border-radius:24px;font-family:Arial,sans-serif;">
    <h1 style="margin-top:0;">Verify this phone or tablet</h1>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div style="padding:14px;border-radius:12px;background:#fff0f0;color:#a51d1d;">
            @error
        </div>
    }
    else
    {
        <p>
            This step is only used to check how many website accounts are linked
            to this phone or tablet before a new Passkey is registered.
        </p>

        <div id="bindingMessage"
             style="margin:18px 0;padding:14px;border-radius:12px;background:#eef6ff;">
            Ready to verify this device.
        </div>

        <form id="bindingForm">
            @Html.AntiForgeryToken()
            <input type="hidden"
                   id="bindingToken"
                   value="@token" />

            <button type="button"
                    id="verifyBindingButton"
                    style="width:100%;padding:14px 18px;border:0;border-radius:14px;font-size:16px;font-weight:700;cursor:pointer;">
                Verify this device
            </button>
        </form>
    }
</div>

<script src="~/js/passkey-device-binding.js"
        asp-append-version="true"></script>
