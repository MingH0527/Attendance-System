@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet"
      href="~/css/forgot_password.css"
      asp-append-version="true" />

<div class="forgot-password-page">

    <div class="forgot-password-card">

        <div class="page-icon">
            🔒
        </div>

        <h1>Reset Password</h1>

        <p class="page-description">
            Enter your username and create a new password.
        </p>

        @if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
        {
            <div class="alert-message error-message">
                @ViewBag.Error
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ViewBag.Message as string))
        {
            <div class="alert-message success-message">
                @ViewBag.Message
            </div>
        }

        <form id="forgotPasswordForm"
              asp-controller="Account"
              asp-action="ForgotPassword"
              method="post"
              autocomplete="off"
              novalidate>

            @Html.AntiForgeryToken()

            <!-- Username -->
            <div class="form-field">

                <label for="username">
                    Username
                </label>

                <div class="input-container">

                    <span class="input-icon">
                        👤
                    </span>

                    <input id="username"
                           name="username"
                           type="text"
                           value="@ViewBag.Username"
                           placeholder="Enter your username"
                           maxlength="30"
                           autocomplete="username" />

                </div>

                <span id="usernameError"
                      class="field-error">
                </span>

            </div>

            <!-- New Password -->
            <div class="form-field">

                <label for="password">
                    New Password
                </label>

                <div class="input-container">

                    <span class="input-icon">
                        🔑
                    </span>

                    <input id="password"
                           name="password"
                           type="password"
                           placeholder="Enter your new password"
                           minlength="8"
                           maxlength="15"
                           autocomplete="new-password" />

                    <button type="button"
                            class="show-password-button"
                            data-password-target="password">
                        Show
                    </button>

                </div>

                <span id="passwordError"
                      class="field-error">
                </span>

            </div>

            <!-- Password validation -->
            <div class="password-rules">

                <p>Password must contain:</p>

                <div id="lengthRule"
                     class="password-rule">
                    <span class="rule-icon">○</span>
                    8–15 characters
                </div>

                <div id="uppercaseRule"
                     class="password-rule">
                    <span class="rule-icon">○</span>
                    At least one uppercase letter
                </div>

                <div id="lowercaseRule"
                     class="password-rule">
                    <span class="rule-icon">○</span>
                    At least one lowercase letter
                </div>

                <div id="numberRule"
                     class="password-rule">
                    <span class="rule-icon">○</span>
                    At least one number
                </div>

                <div id="symbolRule"
                     class="password-rule">
                    <span class="rule-icon">○</span>
                    At least one symbol: @@ $ ! % * ? &amp;
                </div>

            </div>

            <!-- Confirm Password -->
            <div class="form-field">

                <label for="confirmPassword">
                    Confirm Password
                </label>

                <div class="input-container">

                    <span class="input-icon">
                        🔐
                    </span>

                    <input id="confirmPassword"
                           name="confirmPassword"
                           type="password"
                           placeholder="Enter the same password again"
                           minlength="8"
                           maxlength="15"
                           autocomplete="new-password" />

                    <button type="button"
                            class="show-password-button"
                            data-password-target="confirmPassword">
                        Show
                    </button>

                </div>

                <span id="confirmPasswordError"
                      class="field-error">
                </span>

            </div>

            <button type="submit"
                    class="change-password-button">
                Change Password
            </button>

        </form>

        <a asp-controller="Account"
           asp-action="Login"
           class="back-link">
            ← Back to Login
        </a>

    </div>

</div>

<script src="~/js/forgot_password.js"
        asp-append-version="true">
</script>