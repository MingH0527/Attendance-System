@model WebAndMobile.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";

    string? warningLevel =
        ViewBag.LoginWarningLevel as string;

    string errorClass = warningLevel switch
    {
        "yellow" => "login-message login-warning-yellow",
        "orange" => "login-message login-warning-orange",
        "red" => "login-message login-warning-red",
        "locked" => "login-message login-warning-locked",
        _ => "login-message error-message"
    };
}

<link rel="stylesheet"
      href="~/css/login.css"
      asp-append-version="true" />

<div class="login-page">

    <div class="login-card">

        <!-- Back Button -->
        <a href="/"
           class="back-link">
            <span class="back-icon">↩</span>
            BACK
        </a>

        <h1 class="login-title">LOGIN</h1>

        <div asp-validation-summary="ModelOnly"
             class="validation-summary-errors">
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="login-message success-message">
                @ViewBag.Message
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="@errorClass">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="Login"
              method="post"
              id="loginForm"
              autocomplete="off">

            @Html.AntiForgeryToken()

            <!-- Username -->
            <div class="form-group">

                <label for="username"
                       class="form-label">
                    <span class="label-icon username-icon">👤</span>
                    Username
                </label>

                <input asp-for="Username"
                       id="username"
                       class="form-input"
                       placeholder="Please enter your name"
                       autocomplete="off"
                       aria-invalid="false" />

                <span asp-validation-for="Username"
                      class="field-error"
                      id="usernameError"></span>
            </div>

            <!-- Password -->
            <div class="form-group">

                <label for="password"
                       class="form-label">
                    <span class="label-icon">🔒</span>
                    Password
                </label>

                <div class="password-container">

                    <input asp-for="Password"
                           id="password"
                           type="password"
                           class="form-input password-input"
                           placeholder="Please enter your password"
                           autocomplete="new-password"
                           aria-invalid="false" />

                    <button type="button"
                            class="password-toggle"
                            id="passwordToggle"
                            aria-label="Show password">
                        🙈
                    </button>

                </div>

                <span asp-validation-for="Password"
                      class="field-error"
                      id="passwordError"></span>
            </div>

            <div class="forgot-row">
                <a asp-controller="Account"
                   asp-action="ForgotPassword"
                   class="forgot-link">
                    Forgot password?
                </a>
            </div>

            <!-- Remember Me -->
            <div class="login-options">

                <div>

                    <label class="remember-container">

                        <input asp-for="RememberMe"
                               id="rememberMe" />

                        <span class="custom-checkbox"></span>

                        <span class="remember-text">
                            Remember me
                        </span>

                    </label>

                    <small class="field-hint"
                           id="rememberMeStatus">
                        Remember Me is disabled. You will be signed out when the browser is closed.
                    </small>

                </div>

            </div>

            <!-- Login Button -->
            <button type="submit"
                    class="login-button"
                    id="loginButton">
                LOGIN
            </button>

        </form>

        <!-- Register Link -->
        <p class="register-text">
            Don't have an account?

            <a asp-controller="Account"
               asp-action="Register"
               class="register-link">
                Register Now!
            </a>
        </p>

    </div>

</div>

<script src="~/js/login.js"
        asp-append-version="true"></script>
