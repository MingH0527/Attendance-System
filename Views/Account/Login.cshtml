@model WebAndMobile.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";

    string warningLevel =
        ViewBag.LoginWarningLevel ?? "";

    string errorClass =
        warningLevel switch
        {
            "yellow" =>
                "login-warning-yellow",

            "orange" =>
                "login-warning-orange",

            "red" =>
                "login-warning-red",

            "locked" =>
                "login-warning-locked",

            _ =>
                "error-message"
        };
}

<link rel="stylesheet"
      href="~/css/login.css"
      asp-append-version="true" />

<div class="login-page">

    <main class="login-card">

        <a asp-controller="Home"
           asp-action="Index"
           class="back-link">

            <span class="back-icon">
                ←
            </span>

            Back to Home

        </a>

        <h1 class="login-title">
            Welcome Back
        </h1>

        @if (ViewBag.Message != null)
        {
            <div class="login-message success-message">
                @ViewBag.Message
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="login-message @errorClass">
                @ViewBag.Error
            </div>
        }

        <div id="passkeyLoginMessage"
             class="login-message"
             hidden>
        </div>

        <!-- Login Method Buttons -->
        <div class="login-method-tabs">

            <button type="button"
                    id="usernameLoginTab"
                    class="login-method-tab active">

                <span class="method-icon">
                    👤
                </span>

                <span>
                    Login with Username
                </span>

            </button>

            <button type="button"
                    id="passkeyLoginTab"
                    class="login-method-tab">

                <span class="method-icon">
                    🔐
                </span>

                <span>
                    Login with Passkey
                </span>

            </button>

        </div>

        <!-- ==========================================
             USERNAME LOGIN PANEL
             ========================================== -->

        <section id="usernameLoginPanel"
                 class="login-panel">

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  id="loginForm"
                  novalidate>

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly">
                </div>

                <div class="form-group">

                    <label asp-for="Username"
                           class="form-label">

                        <span class="label-icon username-icon">
                            👤
                        </span>

                        Username

                    </label>

                    <input asp-for="Username"
                           id="username"
                           class="form-input"
                           autocomplete="off"
                           placeholder="Enter your username" />

                    <span asp-validation-for="Username"
                          id="usernameError"
                          class="field-error">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Password"
                           class="form-label">

                        <span class="label-icon">
                            🔒
                        </span>

                        Password

                    </label>

                    <div class="password-container">

                        <input asp-for="Password"
                               id="password"
                               type="password"
                               class="form-input password-input"
                               autocomplete="current-password"
                               placeholder="Enter your password" />

                        <button type="button"
                                id="passwordToggle"
                                class="password-toggle"
                                aria-label="Show password">

                            👁️

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          id="passwordError"
                          class="field-error">
                    </span>

                </div>

                <div class="login-options">

                    <label class="remember-container">

                        <input asp-for="RememberMe"
                               id="rememberMe" />

                        <span class="custom-checkbox">
                        </span>

                        <span class="remember-text">
                            Remember me
                        </span>

                    </label>

                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="forgot-link">

                        Forgot Password?

                    </a>

                </div>

                <button type="submit"
                        id="loginButton"
                        class="login-button">

                    Login

                </button>

            </form>

        </section>

        <!-- ==========================================
             PASSKEY LOGIN PANEL
             ========================================== -->

        <section id="passkeyLoginPanel"
                 class="login-panel"
                 hidden>

            <div class="passkey-login-content">

                <div class="passkey-login-icon">
                    🔐
                </div>

                <h2>
                    Login with Passkey
                </h2>

                <p>
                    Use Windows Hello, fingerprint, Face ID,
                    device PIN or another device.
                </p>

                <div class="passkey-feature-list">

                    <div>
                        <span>✓</span>
                        No username or password required
                    </div>

                    <div>
                        <span>✓</span>
                        Your biometric data stays on your device
                    </div>

                    <div>
                        <span>✓</span>
                        Choose another device to display a QR code
                    </div>

                </div>

                <button type="button"
                        id="startPasskeyLoginButton"
                        class="passkey-login-button">

                    <span class="passkey-button-icon">
                        🔑
                    </span>

                    <span id="passkeyLoginButtonText">
                        Continue with Passkey
                    </span>

                </button>

                <p class="passkey-help-text">
                    Select “Use another device” to sign in
                    using your phone.
                </p>

            </div>

        </section>

        <!-- Token used by Passkey AJAX requests -->
        <form id="passkeyLoginTokenForm"
              method="post"
              style="display: none;">

            @Html.AntiForgeryToken()

        </form>

        <p class="register-text">

            Don't have an account?

            <a asp-controller="Account"
               asp-action="Register"
               class="register-link">

                Register

            </a>

        </p>

    </main>

</div>

@section Scripts {

    <script src="~/js/login.js"
            asp-append-version="true">
    </script>

}