@{
    ViewData["Title"] = "Password Reset OTP"; int resendRemaining = ViewBag.ResendRemaining ?? 0;
}
<link rel="stylesheet" href="~/css/otp.css" asp-append-version="true" />
<div class="otp-container">
    <div class="otp-card">
        <h1>Reset Password</h1><p>Enter the OTP sent to:</p><strong class="email">@ViewBag.Email</strong>
        <div class="timer" id="otpTimer">01:00</div>
        <div class="resend-status @ViewBag.ResendClass">Resend attempts remaining: <strong>@resendRemaining</strong></div>
        @if (ViewBag.Message != null)
        {
            <div class="success-message">@ViewBag.Message</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="error-message">@ViewBag.Error</div>
        }
        <form asp-action="ForgotPasswordOtp" method="post" autocomplete="off">
            @Html.AntiForgeryToken()<input type="hidden" name="userId" value="@ViewBag.UserId" />
            <input id="otp" name="otp" maxlength="6" inputmode="numeric" autocomplete="off" placeholder="000000" required />
            <button type="submit">Verify OTP</button>
        </form>
        <form asp-action="ResendForgotPasswordOtp" method="post" id="resendForm">
            @Html.AntiForgeryToken()<input type="hidden" name="userId" value="@ViewBag.UserId" />
            <button type="submit" id="resendButton" class="resend-button" disabled="@(resendRemaining == 0)">Resend OTP</button>
        </form>
        <a asp-action="Login" class="back-link">Back to Login</a>
    </div>
</div>
<script>window.otpPage={expiresAtUtc:'@ViewBag.OtpExpiresAtUtc',resendRemaining:@resendRemaining,resendFormId:'resendForm'};</script>
<script src="~/js/otp.js" asp-append-version="true"></script>
