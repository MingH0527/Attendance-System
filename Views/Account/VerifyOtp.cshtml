@{
    ViewData["Title"] = "Verify OTP";
}

<div class="otp-container">

    <div class="otp-card">

        <h1>Email Verification</h1>

        <p>
            We sent a 6-digit OTP to:
        </p>

        <strong class="email">
            @ViewBag.Email
        </strong>

        <p class="expiry">
            The OTP expires in 5 minutes.
        </p>

        @if (ViewBag.Message != null)
        {
            <div class="success-message">
                @ViewBag.Message
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="VerifyOtp"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="userId"
                   value="@ViewBag.UserId" />

            <input type="text"
                   id="otp"
                   name="otp"
                   maxlength="6"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   placeholder="000000"
                   required />

            <button type="submit">
                Verify OTP
            </button>

        </form>

        <form asp-controller="Account"
              asp-action="ResendOtp"
              method="post"
              class="resend-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="userId"
                   value="@ViewBag.UserId" />

            <button type="submit"
                    class="resend-button">
                Resend OTP
            </button>

        </form>

        <a asp-controller="Account"
           asp-action="Login"
           class="back-link">
            Back to Login
        </a>

    </div>

</div>

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #eef4ff;
    }

    .otp-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .otp-card {
        width: 100%;
        max-width: 430px;
        background: white;
        padding: 35px;
        border-radius: 16px;
        text-align: center;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
    }

        .otp-card h1 {
            margin-top: 0;
            color: #1e293b;
        }

    .email {
        display: block;
        color: #2563eb;
        margin: 10px 0;
    }

    .expiry {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .success-message {
        background: #e9f9ef;
        color: #18733c;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .error-message {
        background: #fff0f0;
        color: #b42318;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    #otp {
        width: 100%;
        padding: 14px;
        box-sizing: border-box;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        letter-spacing: 8px;
        outline: none;
    }

        #otp:focus {
            border-color: #2563eb;
        }

    form button {
        width: 100%;
        margin-top: 16px;
        padding: 13px;
        border: none;
        border-radius: 8px;
        background: #2563eb;
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

        form button:hover {
            background: #1d4ed8;
        }

    .resend-form {
        margin-top: 5px;
    }

    .resend-button {
        background: transparent;
        color: #2563eb;
        margin-top: 10px;
    }

        .resend-button:hover {
            background: transparent;
            text-decoration: underline;
        }

    .back-link {
        display: inline-block;
        margin-top: 16px;
        color: #64748b;
        text-decoration: none;
    }

        .back-link:hover {
            color: #2563eb;
        }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const otpInput =
            document.getElementById("otp");

        if (!otpInput) {
            return;
        }

        otpInput.addEventListener(
            "input",
            function () {

                let cleanedValue = "";

                for (let index = 0;
                     index < otpInput.value.length;
                     index++) {

                    const currentCharacter =
                        otpInput.value[index];

                    if (
                        currentCharacter >= "0" &&
                        currentCharacter <= "9"
                    ) {
                        cleanedValue +=
                            currentCharacter;
                    }
                }

                otpInput.value =
                    cleanedValue.substring(
                        0,
                        6
                    );
            }
        );
    });
</script>