@using System.Text.Json
@{
    ViewData["Title"] = "Verify OTP";
    int resendRemaining = ViewBag.ResendRemaining ?? 0;
    string? expiresAtUtc = ViewBag.OtpExpiresAtUtc as string;
}

<link rel="stylesheet" href="~/css/otp.css" asp-append-version="true" />

<div class="otp-container">
    <div class="otp-card">
        <h1>Email Verification</h1>

        <p>We sent a 6-digit OTP to:</p>
        <strong class="email">@ViewBag.Email</strong>

        <div class="timer" id="otpTimer">01:00</div>
        <p class="expiry">This OTP is valid for 1 minute.</p>

        <div class="resend-status @ViewBag.ResendClass">
            Resend attempts remaining:
            <strong id="resendRemaining">@resendRemaining</strong>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="success-message">@ViewBag.Message</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="error-message">@ViewBag.Error</div>
        }

        <form asp-action="VerifyOtp" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <input id="otp"
                   name="otp"
                   maxlength="6"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   placeholder="000000"
                   required />

            <button type="submit">Verify OTP</button>
        </form>

        <form asp-action="ResendOtp"
              method="post"
              id="resendForm">
            @Html.AntiForgeryToken()

            <button type="submit"
                    id="resendButton"
                    class="resend-button"
                    disabled>
                Resend OTP
            </button>
        </form>

        <form asp-action="CancelOtp"
              method="post"
              id="cancelForm">
            @Html.AntiForgeryToken()
        </form>

        <button type="button"
                class="back-link"
                id="cancelRegistrationButton">
            Back to Register
        </button>
    </div>
</div>

<script>
    window.otpPage = {
        expiresAtUtc: @Html.Raw(JsonSerializer.Serialize(expiresAtUtc)),
        resendRemaining: @resendRemaining,
        resendFormId: "resendForm",
        cancelFormId: "cancelForm"
    };
</script>
<script src="~/js/otp.js" asp-append-version="true"></script>
