@model WebAndMobile.ViewModels.TeacherProfileSetupViewModel
@{
    ViewData["Title"] = "Complete Teacher Information";
}

<div style="max-width:620px;margin:40px auto;padding:28px;background:#fff;border:1px solid #e2e8f0;border-radius:16px;">
    <h1>Complete Teacher Information</h1>
    <p style="color:#64748b">Choose your program first. The Subject list only shows subjects registered by Admin under that program.</p>
    <form asp-controller="Teacher" asp-action="Create" method="post" id="teacherSetupForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color:#b91c1c"></div>
        <label style="display:block;font-weight:700;margin-top:16px">Program</label>
        <select asp-for="ProgramId" id="teacherProgram" style="width:100%;padding:10px;margin-top:6px" required>
            <option value="">Select program</option>
            @foreach (var p in Model.Programs) { <option value="@p.ProgramId">@p.ProgramCode · @p.ProgramName</option> }
        </select>
        <label style="display:block;font-weight:700;margin-top:16px">Subject</label>
        <select asp-for="CourseId" id="teacherSubject" style="width:100%;padding:10px;margin-top:6px" required disabled>
            <option value="">Select program first</option>
        </select>
        <button type="submit" style="margin-top:22px;padding:10px 20px;border:0;border-radius:8px;background:#0f6cbd;color:#fff">Save Profile</button>
    </form>
</div>

<script>
(() => {
    const program = document.getElementById('teacherProgram');
    const subject = document.getElementById('teacherSubject');
    const selectedCourse = '@(Model.CourseId ?? "")';
    async function loadSubjects() {
        const id = program.value;
        if (!id) { subject.innerHTML = '<option value="">Select program first</option>'; subject.disabled = true; return; }
        const r = await fetch(`/Teacher/Subjects?programId=${encodeURIComponent(id)}`);
        const rows = r.ok ? await r.json() : [];
        subject.innerHTML = '<option value="">Select subject</option>' + rows.map(x => `<option value="${x.id}" ${x.id === selectedCourse ? 'selected' : ''}>${x.code ? x.code + ' · ' : ''}${x.name}</option>`).join('');
        subject.disabled = false;
    }
    program.addEventListener('change', loadSubjects);
    if (program.value) loadSubjects();
})();
</script>
