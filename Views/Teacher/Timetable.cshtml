@model WebAndMobile.Models.TeacherTimetableViewModel

@{
    ViewData["Title"] =
        "My Timetable";

    var days =
        new List<DayOfWeek>
        {
            DayOfWeek.Monday,
            DayOfWeek.Tuesday,
            DayOfWeek.Wednesday,
            DayOfWeek.Thursday,
            DayOfWeek.Friday,
            DayOfWeek.Saturday
        };

    if (
        Model.Items.Any(i =>
            i.DayOfWeek ==
            DayOfWeek.Sunday
        )
    )
    {
        days.Add(
            DayOfWeek.Sunday
        );
    }


    int startHour =
        8;

    int endHour =
        18;


    if (
        Model.Items.Count >
        0
    )
    {
        startHour =
            Math.Min(
                8,
                Model.Items.Min(i =>
                    i.StartTime.Hours
                )
            );

        endHour =
            Math.Max(
                18,
                (int)Math.Ceiling(
                    Model.Items.Max(i =>
                        i.EndTime.TotalHours
                    )
                )
            );
    }


    var courseIds =
        Model.Items
            .Where(i =>
                i.Status !=
                "Replacement"
            )
            .Select(i =>
                i.CourseId
            )
            .Distinct()
            .ToList();


    var subjectColours =
        new Dictionary<string, int>();


    for (
        int i = 0;
        i < courseIds.Count;
        i++
    )
    {
        subjectColours[
            courseIds[i]
        ] =
            (i % 10) + 1;
    }
}

<link rel="stylesheet"
      href="~/css/teacherhome.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/teacher-timetable.css"
      asp-append-version="true" />


<div class="teacher-dashboard">


    <!-- ==============================
         HEADER
         ============================== -->

    <header class="teacher-header timetable-header">

        <div>

            <a asp-controller="Teacher"
               asp-action="Index"
               class="tt-back-link">

                ← Back to Dashboard

            </a>

            <p class="teacher-role">
                Teacher Portal
            </p>

            <h1>
                My Timetable
            </h1>

            <p>
                View your weekly teaching schedule,
                cancelled classes and replacements.
            </p>

        </div>


        <a asp-controller="Teacher"
           asp-action="AttendanceCode"
           class="attendance-page-button">

            🔢 Generate Attendance Code

        </a>

    </header>


    <!-- ==============================
         WEEK SELECTOR
         ============================== -->
    @if (
            Model.Weeks.Count >
            0
        )
    {
        <section class="teacher-week-bar">

            <div>

                <strong>
                    @Model.TermName
                </strong>

                @if (
                    !Model.IsTemplate &&
                    Model.WeekStart != null &&
                    Model.WeekEnd != null
                )
                {
                    <span>

                        @Model.WeekStart.Value.ToString("dd MMM")
                        -
                        @Model.WeekEnd.Value.ToString("dd MMM yyyy")

                    </span>
                }
                else
                {
                    <span>
                        Standard weekly schedule
                    </span>
                }

            </div>


            <form asp-controller="Teacher"
                  asp-action="Timetable"
                  method="get">

                <select name="weekNumber"
                        onchange="this.form.submit()">

                    @if (
                        Model.IsTemplate
                    )
                    {
                        <option value="0"
                                selected>
                            Weekly Template
                        </option>
                    }
                    else
                    {
                        <option value="0">
                            Weekly Template
                        </option>
                    }


                    @foreach (
                        var week
                        in Model.Weeks
                    )
                    {
                        if (
                            !Model.IsTemplate &&
                            Model.SelectedWeekNumber ==
                                week.WeekNumber
                        )
                        {
                            <option value="@week.WeekNumber"
                                    selected>

                                Week @week.WeekNumber

                            </option>
                        }
                        else
                        {
                            <option value="@week.WeekNumber">

                                Week @week.WeekNumber

                            </option>
                        }
                    }

                </select>

            </form>

        </section>
    }


    <!-- ==============================
         LEGEND
         ============================== -->

    <div class="teacher-tt-legend">

        <span>
            <i class="legend-normal"></i>
            Subjects
        </span>

        <span>
            <i class="legend-replacement"></i>
            Replacement
        </span>

        <span>
            <i class="legend-cancelled"></i>
            Cancelled
        </span>

    </div>


    <!-- ==============================
         NOTIFICATIONS
         ============================== -->
    @if (
            Model.Notifications.Count >
            0
        )
    {
        <section class="teacher-notifications">

            <strong>
                Recent Timetable Changes
            </strong>

            @foreach (
                var notification
                in Model.Notifications
                    .Take(3)
            )
            {
                <div class="teacher-notification">

                    <span>
                        @notification.Message
                    </span>

                    <small>
                        @notification.CreatedAt
                        .ToString(
                        "dd MMM yyyy HH:mm"
                        )
                    </small>

                </div>
            }

        </section>
    }


    <!-- ==============================
         TIMETABLE
         ============================== -->

    <section class="teacher-grid-card">

        @if (
            Model.Items.Count ==
            0
        )
        {
            <div class="teacher-tt-empty">

                📅

                <strong>
                    No timetable entries
                </strong>

                <span>
                    There are no classes available
                    for this timetable.
                </span>

            </div>
        }
        else
        {
            <div class="teacher-grid-scroll">

                <table class="teacher-tt-grid">

                    <thead>

                        <tr>

                            <th class="teacher-day-heading">
                                Day / Time
                            </th>


                            @for (
                                int hour =
                                    startHour;
                                hour <
                                    endHour;
                                hour++
                            )
                            {
                                DateTime start =
                                    DateTime.Today
                                        .AddHours(
                                            hour
                                        );

                                DateTime end =
                                    start
                                        .AddHours(
                                            1
                                        );

                                <th>

                                    @start.ToString("h:mm tt")
                                    -
                                    <br />
                                    @end.ToString("h:mm tt")

                                </th>
                            }

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            DayOfWeek day
                            in days
                        )
                        {
                            <tr>

                                <th class="teacher-day-label">
                                    @day
                                </th>


                                @for (
                                    int hour =
                                        startHour;
                                    hour <
                                        endHour;
                                    hour++
                                )
                                {
                                    var cellItems =
                                        Model.Items
                                            .Where(i =>
                                                i.DayOfWeek ==
                                                    day &&
                                                i.StartTime.Hours ==
                                                    hour
                                            )
                                            .OrderBy(i =>
                                                i.StartTime
                                            )
                                            .ToList();


                                    <td class="teacher-tt-cell">

                                        @foreach (
                                            var item
                                            in cellItems
                                        )
                                        {
                                            string colourClass;


                                            if (
                                                item.Status ==
                                                "Replacement"
                                            )
                                            {
                                                colourClass =
                                                    "replacement";
                                            }
                                            else if (
                                                item.Status ==
                                                "Cancelled"
                                            )
                                            {
                                                colourClass =
                                                    "cancelled";
                                            }
                                            else
                                            {
                                                int colour =
                                                    subjectColours
                                                        .GetValueOrDefault(
                                                            item.CourseId,
                                                            1
                                                        );

                                                colourClass =
                                                    $"subject-color-{colour}";
                                            }


                                            <div class="teacher-class-block @colourClass">

                                                @if (
                                                    item.Status ==
                                                    "Replacement"
                                                )
                                                {
                                                    <span class="teacher-status-badge replacement-badge">
                                                        Replacement
                                                    </span>
                                                }


                                                @if (
                                                    item.Status ==
                                                    "Cancelled"
                                                )
                                                {
                                                    <span class="teacher-status-badge cancelled-badge">
                                                        Cancelled
                                                    </span>
                                                }


                                                <strong>
                                                    @item.CourseName
                                                </strong>


                                                <span>
                                                    @item.StartTime.ToString(@"hh\:mm")
                                                    -
                                                    @item.EndTime.ToString(@"hh\:mm")
                                                </span>


                                                <span>
                                                    @item.ClassName
                                                </span>


                                                <small>
                                                    @item.RoomName
                                                    ·
                                                    @item.ClassType
                                                </small>


                                                @if (
                                                    !string.IsNullOrWhiteSpace(
                                                        item.Reason
                                                    )
                                                )
                                                {
                                                    <small class="teacher-class-reason">
                                                        @item.Reason
                                                    </small>
                                                }

                                            </div>
                                        }

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>