@model WebAndMobile.Models.TeacherTimetableViewModel
@using WebAndMobile.Models

@{
    ViewData["Title"] = "My Timetable";


    // ==================================================
    // DAYS
    // ==================================================

    List<DayOfWeek> days =
        new()
        {
            DayOfWeek.Monday,
            DayOfWeek.Tuesday,
            DayOfWeek.Wednesday,
            DayOfWeek.Thursday,
            DayOfWeek.Friday,
            DayOfWeek.Saturday
        };


    if (
        Model.Items.Any(i =>
            i.DayOfWeek ==
                DayOfWeek.Sunday
        )
    )
    {
        days.Add(
            DayOfWeek.Sunday
        );
    }



    // ==================================================
    // TIME RANGE
    // ==================================================

    int startHour =
        8;

    int endHour =
        18;


    if (Model.Items.Count > 0)
    {
        int earliestHour =
            Model.Items
                .Min(i =>
                    i.StartTime.Hours
                );


        int latestHour =
            Model.Items
                .Max(i =>
                    i.EndTime.Minutes > 0
                        ? i.EndTime.Hours + 1
                        : i.EndTime.Hours
                );


        if (
            earliestHour <
            startHour
        )
        {
            startHour =
                earliestHour;
        }


        if (
            latestHour >
            endHour
        )
        {
            endHour =
                latestHour;
        }
    }



    // ==================================================
    // RECENT NOTIFICATION COUNT
    // ==================================================

    int recentNotificationCount =
        Model.Notifications
            ?.Count
        ?? 0;


    if (
        ViewBag.RecentNotificationCount !=
        null
    )
    {
        recentNotificationCount =
            Convert.ToInt32(
                ViewBag.RecentNotificationCount
            );
    }
}


<link rel="stylesheet"
      href="~/css/teacher-timetable.css"
      asp-append-version="true" />



<div class="teacher-dashboard">


    <!-- ==================================================
         HEADER
         ================================================== -->

    <section class="teacher-header timetable-header">


        <div class="timetable-header-content">


            <a asp-controller="Teacher"
               asp-action="Index"
               class="tt-back-link">

                ← Back to Dashboard

            </a>


            <p class="teacher-role">

                TEACHER PORTAL

            </p>


            <h1>

                My Timetable

            </h1>


            <p class="teacher-header-description">

                View your weekly teaching schedule,
                replacement classes and cancelled lessons.

            </p>


        </div>



        <!-- ==================================================
             GENERATE ATTENDANCE CODE
             ================================================== -->

        <a asp-controller="Teacher"
           asp-action="AttendanceCode"
           class="attendance-page-button">


            <span class="attendance-button-icon">

                #

            </span>


            Generate Attendance Code


        </a>


    </section>



    <!-- ==================================================
         WEEK SELECTOR
         ================================================== -->

    <section class="teacher-week-bar">


        <div class="week-information">


            <span class="week-label">

                CURRENT VIEW

            </span>


            @if (Model.IsTemplate)
            {

                <strong>

                    Weekly Template

                </strong>


                <span class="week-date">

                    @Model.TermName

                </span>

            }
            else
            {

                <strong>

                    Week @Model.SelectedWeekNumber

                </strong>


                @if (
                    Model.WeekStart.HasValue &&
                    Model.WeekEnd.HasValue
                )
                {

                    <span class="week-date">

                        @Model.WeekStart.Value.ToString("dd MMM yyyy")

                        -

                        @Model.WeekEnd.Value.ToString("dd MMM yyyy")

                    </span>

                }

            }


        </div>



        <!-- ==================================================
             WEEK DROPDOWN
             ================================================== -->

        <form asp-controller="Teacher"
              asp-action="Timetable"
              method="get"
              class="week-selector-form">


            <label for="weekNumber">

                View:

            </label>


            <select id="weekNumber"
                    name="weekNumber"
                    onchange="this.form.submit()">



                <!-- WEEKLY TEMPLATE -->

                @if (Model.IsTemplate)
                {

                    <option value="0"
                            selected>

                        Weekly Template

                    </option>

                }
                else
                {

                    <option value="0">

                        Weekly Template

                    </option>

                }



                <!-- WEEK LIST -->

                @foreach (
                    AcademicWeek week
                    in Model.Weeks
                )
                {

                    if (
                        Model.SelectedWeekNumber ==
                            week.WeekNumber &&
                        !Model.IsTemplate
                    )
                    {

                        <option value="@week.WeekNumber"
                                selected>

                            Week @week.WeekNumber
                            (@week.StartDate.ToString("dd MMM")
                            -
                            @week.EndDate.ToString("dd MMM"))

                        </option>

                    }
                    else
                    {

                        <option value="@week.WeekNumber">

                            Week @week.WeekNumber
                            (@week.StartDate.ToString("dd MMM")
                            -
                            @week.EndDate.ToString("dd MMM"))

                        </option>

                    }

                }


            </select>


        </form>


    </section>



    <!-- ==================================================
         LEGEND
         ================================================== -->

    <div class="teacher-tt-legend">


        <span>

            <i class="legend-normal"></i>

            Subject

        </span>


        <span>

            <i class="legend-replacement"></i>

            Replacement

        </span>


        <span>

            <i class="legend-cancelled"></i>

            Cancelled

        </span>


    </div>



    <!-- ==================================================
         RECENT TIMETABLE CHANGES
         ================================================== -->

    <section class="teacher-notifications">


        <div class="notification-heading">


            <div>


                <span class="notification-icon">

                    🔔

                </span>


                <strong>

                    Recent Timetable Changes

                </strong>


            </div>



            <div class="notification-heading-actions">


                <span class="notification-count">

                    @recentNotificationCount

                </span>


                <a asp-controller="Teacher"
                   asp-action="TimetableChanges"
                   class="notification-view-all">

                    View all changes →

                </a>


            </div>


        </div>



        <!-- ==================================================
             NOTIFICATIONS
             ================================================== -->

        @if (
            Model.Notifications != null &&
            Model.Notifications.Count > 0
        )
        {

            <div class="notification-list">


                @foreach (
                    TimetableNotification notification
                    in Model.Notifications
                )
                {

                    <div class="teacher-notification">


                        <div class="notification-message">


                            <strong>

                                @notification.Type

                            </strong>


                            <span>

                                @notification.Message

                            </span>


                        </div>


                        <small>

                            @notification.CreatedAt.ToString(
                                "dd MMM yyyy HH:mm"
                            )

                        </small>


                    </div>

                }


            </div>

        }
        else
        {

            <div class="notification-list">


                <div class="teacher-notification">


                    <div class="notification-message">


                        <span>

                            No recent timetable changes.

                        </span>


                    </div>


                </div>


            </div>

        }


    </section>



    <!-- ==================================================
         TIMETABLE
         ================================================== -->

    <section class="teacher-grid-card">


        <!-- ==================================================
             EMPTY
             ================================================== -->

        @if (
            Model.Items == null ||
            Model.Items.Count == 0
        )
        {

            <div class="teacher-tt-empty">


                <div class="empty-calendar-icon">

                    📅

                </div>


                <strong>

                    No timetable entries

                </strong>


                <span>

                    There are currently no timetable
                    entries available for this semester.

                </span>


            </div>

        }


        <!-- ==================================================
             TIMETABLE EXISTS
             ================================================== -->

        else
        {

            <div class="teacher-grid-scroll">


                <table class="teacher-tt-grid">



                    <!-- ======================================
                         TIME HEADER
                         ====================================== -->

                    <thead>


                        <tr>


                            <th class="teacher-day-heading">

                                Day

                            </th>



                            @for (
                                int hour =
                                    startHour;
                                hour <
                                    endHour;
                                hour++
                            )
                            {

                                DateTime start =
                                    DateTime.Today
                                        .AddHours(
                                            hour
                                        );


                                DateTime end =
                                    start.AddHours(
                                        1
                                    );


                                <th>


                                    <span class="time-start">

                                        @start.ToString("hh:mm tt")

                                    </span>


                                    <span class="time-separator">

                                        -

                                    </span>


                                    <span class="time-end">

                                        @end.ToString("hh:mm tt")

                                    </span>


                                </th>

                            }


                        </tr>


                    </thead>



                    <!-- ======================================
                         TIMETABLE BODY
                         ====================================== -->

                    <tbody>


                        @foreach (
                            DayOfWeek day
                            in days
                        )
                        {

                            DateTime? actualDate =
                                null;



                            // ==========================================
                            // REAL DATE FOR SPECIFIC WEEK
                            // ==========================================

                            if (
                                !Model.IsTemplate &&
                                Model.WeekStart.HasValue
                            )
                            {

                                int dayOffset =
                                    (
                                        (int)day -
                                        (int)DayOfWeek.Monday +
                                        7
                                    )
                                    % 7;


                                actualDate =
                                    Model.WeekStart
                                        .Value
                                        .Date
                                        .AddDays(
                                            dayOffset
                                        );
                            }



                            <tr>



                                <!-- ==================================
                                     DAY + REAL DATE
                                     ================================== -->

                                <th class="teacher-day-label">


                                    <span class="teacher-day-name">

                                        @day

                                    </span>


                                    @if (
                                        actualDate.HasValue
                                    )
                                    {

                                        <small class="teacher-day-date">

                                            @actualDate.Value.ToString(
                                                "dd/MM/yyyy"
                                            )

                                        </small>

                                    }


                                </th>



                                <!-- ==================================
                                     HOURS
                                     ================================== -->

                                @for (
                                    int hour =
                                        startHour;
                                    hour <
                                        endHour;
                                    hour++
                                )
                                {

                                    List<TeacherTimetableItemViewModel>
                                        cellItems =
                                            Model.Items
                                                .Where(i =>
                                                    i.DayOfWeek ==
                                                        day &&
                                                    i.StartTime.Hours ==
                                                        hour
                                                )
                                                .OrderBy(i =>
                                                    i.StartTime
                                                )
                                                .ToList();



                                    <td class="teacher-tt-cell">


                                        @foreach (
                                            TeacherTimetableItemViewModel item
                                            in cellItems
                                        )
                                        {

                                            string colourClass;



                                            // ==================================
                                            // REPLACEMENT
                                            // ==================================

                                            if (
                                                string.Equals(
                                                    item.Status,
                                                    "Replacement",
                                                    StringComparison.OrdinalIgnoreCase
                                                )
                                            )
                                            {

                                                colourClass =
                                                    "replacement";

                                            }


                                            // ==================================
                                            // CANCELLED
                                            // ==================================

                                            else if (
                                                string.Equals(
                                                    item.Status,
                                                    "Cancelled",
                                                    StringComparison.OrdinalIgnoreCase
                                                )
                                            )
                                            {

                                                colourClass =
                                                    "cancelled";

                                            }


                                            // ==================================
                                            // NORMAL
                                            // ==================================

                                            else
                                            {

                                                colourClass =
                                                    "subject-color-5 normal-subject";

                                            }



                                            <!-- ==============================
                                                 CLASS BLOCK
                                                 ============================== -->

                                            <div class="teacher-class-block @colourClass">



                                                <!-- STATUS BADGE -->

                                                @if (
                                                    string.Equals(
                                                        item.Status,
                                                        "Replacement",
                                                        StringComparison.OrdinalIgnoreCase
                                                    )
                                                )
                                                {

                                                    <span class="teacher-status-badge replacement-badge">

                                                        Replacement

                                                    </span>

                                                }
                                                else if (
                                                    string.Equals(
                                                        item.Status,
                                                        "Cancelled",
                                                        StringComparison.OrdinalIgnoreCase
                                                    )
                                                )
                                                {

                                                    <span class="teacher-status-badge cancelled-badge">

                                                        Cancelled

                                                    </span>

                                                }



                                                <!-- COURSE -->

                                                <span class="class-course-name">

                                                    @item.CourseName

                                                </span>



                                                <!-- TIME -->

                                                <span class="class-time">

                                                    @(item.StartTime.ToString(@"hh\:mm"))

                                                    -

                                                    @(item.EndTime.ToString(@"hh\:mm"))

                                                </span>



                                                <!-- CLASS -->

                                                <span class="class-group">

                                                    @item.ClassName

                                                </span>



                                                <!-- ROOM -->

                                                <span class="class-room">

                                                    Room:

                                                    @item.RoomName

                                                </span>



                                                <!-- CLASS TYPE -->

                                                <span class="class-type">

                                                    @item.ClassType

                                                </span>



                                                <!-- DATE -->

                                                @if (
                                                    item.OccurrenceDate
                                                        .HasValue
                                                )
                                                {

                                                    <span class="class-room">

                                                        @item.OccurrenceDate
                                                            .Value
                                                            .ToString(
                                                                "dd MMM yyyy"
                                                            )

                                                    </span>

                                                }



                                                <!-- REASON -->

                                                @if (
                                                    !string.IsNullOrWhiteSpace(
                                                        item.Reason
                                                    )
                                                )
                                                {

                                                    <span class="teacher-class-reason">

                                                        @item.Reason

                                                    </span>

                                                }


                                            </div>

                                        }


                                    </td>

                                }


                            </tr>

                        }


                    </tbody>


                </table>


            </div>

        }


    </section>


</div>