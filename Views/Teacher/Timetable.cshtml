@model WebAndMobile.Models.TeacherTimetableViewModel

@{
    ViewData["Title"] = "My Timetable";

    var days = new List<DayOfWeek>
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday
    };

    if (Model.Items.Any(i => i.DayOfWeek == DayOfWeek.Sunday))
    {
        days.Add(DayOfWeek.Sunday);
    }

    int startHour = 8;
    int endHour = 18;

    if (Model.Items.Count > 0)
    {
        startHour = Math.Min(
            8,
            Model.Items.Min(i => i.StartTime.Hours)
        );

        endHour = Math.Max(
            18,
            (int)Math.Ceiling(
                Model.Items.Max(i => i.EndTime.TotalHours)
            )
        );
    }

    var courseIds = Model.Items
        .Where(i =>
            i.Status != "Replacement" &&
            i.Status != "Cancelled"
        )
        .Select(i => i.CourseId)
        .Distinct()
        .ToList();

    var subjectColours =
        new Dictionary<string, int>();

    for (int i = 0; i < courseIds.Count; i++)
    {
        subjectColours[courseIds[i]] =
            (i % 10) + 1;
    }
}

<link rel="stylesheet"
      href="~/css/teacherhome.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/teacher-timetable.css"
      asp-append-version="true" />


<div class="teacher-dashboard">

    <!-- ==========================================
         HEADER
         ========================================== -->

    <header class="teacher-header timetable-header">

        <div class="timetable-header-content">

            <a asp-controller="Teacher"
               asp-action="Index"
               class="tt-back-link">

                ← Back to Dashboard

            </a>

            <p class="teacher-role">
                Teacher Portal
            </p>

            <h1>
                My Timetable
            </h1>

            <p class="teacher-header-description">
                View your weekly teaching schedule,
                cancelled classes and replacements.
            </p>

        </div>


        <a asp-controller="Teacher"
           asp-action="AttendanceCode"
           class="attendance-page-button">

            <span class="attendance-button-icon">
                🔢
            </span>

            <span>
                Generate Attendance Code
            </span>

        </a>

    </header>


    <!-- ==========================================
         WEEK SELECTOR
         ========================================== -->
    @if (Model.Weeks.Count > 0)
    {
        <section class="teacher-week-bar">

            <div class="week-information">

                <span class="week-label">
                    ACTIVE SEMESTER
                </span>

                <strong>
                    @Model.TermName
                </strong>

                @if (
                    !Model.IsTemplate &&
                    Model.WeekStart != null &&
                    Model.WeekEnd != null
                )
                {
                    <span class="week-date">

                        @(Model.WeekStart.Value.ToString("dd MMM yyyy"))
                        -
                        @(Model.WeekEnd.Value.ToString("dd MMM yyyy"))

                    </span>
                }
                else
                {
                    <span class="week-date">
                        Standard weekly timetable
                    </span>
                }

            </div>


            <form asp-controller="Teacher"
                  asp-action="Timetable"
                  method="get"
                  class="week-selector-form">

                <label for="weekNumber">
                    View
                </label>

                <select id="weekNumber"
                        name="weekNumber"
                        onchange="this.form.submit()">

                    @if (Model.IsTemplate)
                    {
                        <option value="0"
                                selected>
                            Weekly Template
                        </option>
                    }
                    else
                    {
                        <option value="0">
                            Weekly Template
                        </option>
                    }


                    @foreach (var week in Model.Weeks)
                    {
                        if (
                            !Model.IsTemplate &&
                            Model.SelectedWeekNumber ==
                                week.WeekNumber
                        )
                        {
                            <option value="@week.WeekNumber"
                                    selected>

                                Week @week.WeekNumber

                            </option>
                        }
                        else
                        {
                            <option value="@week.WeekNumber">

                                Week @week.WeekNumber

                            </option>
                        }
                    }

                </select>

            </form>

        </section>
    }


    <!-- ==========================================
         LEGEND
         ========================================== -->

    <div class="teacher-tt-legend">

        <span>
            <i class="legend-normal"></i>
            Subjects
        </span>

        <span>
            <i class="legend-replacement"></i>
            Replacement
        </span>

        <span>
            <i class="legend-cancelled"></i>
            Cancelled
        </span>

    </div>


    <!-- ==========================================
         NOTIFICATIONS
         ========================================== -->
    @if (Model.Notifications.Count > 0)
    {
        <section class="teacher-notifications">

            <div class="notification-heading">

                <div>

                    <span class="notification-icon">
                        🔔
                    </span>

                    <strong>
                        Recent Timetable Changes
                    </strong>

                </div>

                <span class="notification-count">
                    @Model.Notifications.Count
                </span>

            </div>


            <div class="notification-list">

                @foreach (
                    var notification
                    in Model.Notifications.Take(3)
                )
                {
                    <div class="teacher-notification">

                        <div class="notification-message">

                            <strong>
                                @(notification.Type == "LessonCancelled"
                                    ? "Class Cancelled"
                                    : "Timetable Updated")
                            </strong>

                            <span>
                                @notification.Message
                            </span>

                        </div>


                        <small>
                            @(notification.CreatedAt.ToString("dd MMM yyyy HH:mm"))
                        </small>

                    </div>
                }

            </div>

        </section>
    }


    <!-- ==========================================
         TIMETABLE CARD
         ========================================== -->

    <section class="teacher-grid-card">

        @if (Model.Items.Count == 0)
        {
            <!-- ==================================
                 EMPTY STATE
                 ================================== -->

            <div class="teacher-tt-empty">

                <div class="empty-calendar-icon">
                    📅
                </div>

                <strong>
                    No timetable entries
                </strong>

                <span>
                    Your scheduled classes will appear here
                    once an active timetable has been assigned to you.
                </span>

            </div>
        }
        else
        {
            <!-- ==================================
                 GRID
                 ================================== -->

            <div class="teacher-grid-scroll">

                <table class="teacher-tt-grid">

                    <thead>

                        <tr>

                            <th class="teacher-day-heading">
                                Day / Time
                            </th>


                            @for (
                                int hour = startHour;
                                hour < endHour;
                                hour++
                            )
                            {
                                DateTime start =
                                    DateTime.Today.AddHours(hour);

                                DateTime end =
                                    start.AddHours(1);

                                <th>

                                    <span class="time-start">
                                        @start.ToString("h:mm tt")
                                    </span>

                                    <span class="time-separator">
                                        -
                                    </span>

                                    <span class="time-end">
                                        @end.ToString("h:mm tt")
                                    </span>

                                </th>
                            }

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (DayOfWeek day in days)
                        {
                            <tr>

                                <th class="teacher-day-label">

                                    <span>
                                        @day
                                    </span>

                                </th>


                                @for (
                                    int hour = startHour;
                                    hour < endHour;
                                    hour++
                                )
                                {
                                    var cellItems =
                                        Model.Items
                                            .Where(i =>
                                                i.DayOfWeek == day &&
                                                i.StartTime.Hours == hour
                                            )
                                            .OrderBy(i =>
                                                i.StartTime
                                            )
                                            .ToList();


                                    <td class="teacher-tt-cell">

                                        @foreach (var item in cellItems)
                                        {
                                            string colourClass;

                                            if (
                                                item.Status ==
                                                "Replacement"
                                            )
                                            {
                                                colourClass =
                                                    "replacement";
                                            }
                                            else if (
                                                item.Status ==
                                                "Cancelled"
                                            )
                                            {
                                                colourClass =
                                                    "cancelled";
                                            }
                                            else
                                            {
                                                int colour =
                                                    subjectColours
                                                        .GetValueOrDefault(
                                                            item.CourseId,
                                                            1
                                                        );

                                                colourClass =
                                                    $"subject-color-{colour}";
                                            }


                                            <div class="teacher-class-block @colourClass">

                                                <!-- STATUS -->
                                                @if (
                                                                                                    item.Status ==
                                                                                                    "Replacement"
                                                                                                )
                                                {
                                                    <span class="teacher-status-badge replacement-badge">

                                                        Replacement

                                                    </span>
                                                }


                                                @if (
                                                    item.Status ==
                                                    "Cancelled"
                                                )
                                                {
                                                    <span class="teacher-status-badge cancelled-badge">

                                                        Cancelled

                                                    </span>
                                                }


                                                <!-- SUBJECT -->

                                                <strong class="class-course-name">

                                                    @item.CourseName

                                                </strong>


                                                <!-- TIME -->

                                                <span class="class-time">

                                                    @(item.StartTime.ToString(@"hh\:mm"))
                                                    -
                                                    @(item.EndTime.ToString(@"hh\:mm"))

                                                </span>


                                                <!-- CLASS -->

                                                <span class="class-group">

                                                    👥 @item.ClassName

                                                </span>


                                                <!-- ROOM -->

                                                <small class="class-room">

                                                    📍 @item.RoomName

                                                </small>


                                                <!-- CLASS TYPE -->

                                                <small class="class-type">

                                                    @item.ClassType

                                                </small>


                                                <!-- REASON -->
                                                @if (
                                                                                                    !string.IsNullOrWhiteSpace(
                                                                                                        item.Reason
                                                                                                    )
                                                                                                )
                                                {
                                                    <small class="teacher-class-reason">

                                                        @item.Reason

                                                    </small>
                                                }

                                            </div>
                                        }

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>