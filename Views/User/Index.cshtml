
@model List<WebAndMobile.Models.UserListItemDto>

@{
    ViewData["Title"] = "User Management";

    int totalUsers = Model.Count;
    int activeUsers = Model.Count(u => u.Status == "Active");
    int teacherCount = Model.Count(u => u.Position == "Teacher");
    int studentCount = Model.Count(u => u.Position == "Student");
}

<link rel="stylesheet" href="~/css/user.css" />

<div class="user-page">

    <div class="user-container">

        <!-- Page Header -->

        <div class="page-header">
            <h1>User Management</h1>

            <p>
                Manage system users, account roles and access status.
            </p>
        </div>


        <!-- Statistics Cards -->

        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-icon total-icon">
                    👥
                </div>

                <div>
                    <span class="stat-label">
                        Total Users
                    </span>

                    <strong class="stat-number">
                        @totalUsers
                    </strong>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon active-icon">
                    ✓
                </div>

                <div>
                    <span class="stat-label">
                        Active Users
                    </span>

                    <strong class="stat-number">
                        @activeUsers
                    </strong>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon teacher-icon">
                    👨‍🏫
                </div>

                <div>
                    <span class="stat-label">
                        Teachers
                    </span>

                    <strong class="stat-number">
                        @teacherCount
                    </strong>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon student-icon">
                    🎓
                </div>

                <div>
                    <span class="stat-label">
                        Students
                    </span>

                    <strong class="stat-number">
                        @studentCount
                    </strong>
                </div>

            </div>

        </div>


        <!-- User Table -->

        <div class="user-card">

            <!-- Search and Filter -->

            <div class="table-toolbar">

                <div class="search-box">

                    <span class="search-icon">
                        🔍
                    </span>

                    <input type="text"
                           id="userSearch"
                           placeholder="Search username, email or phone..." />

                </div>


                <div class="filter-box">

                    <label for="roleFilter">
                        Role
                    </label>

                    <select id="roleFilter">

                        <option value="all">
                            All Roles
                        </option>

                        <option value="Admin">
                            Admin
                        </option>

                        <option value="Teacher">
                            Teacher
                        </option>

                        <option value="Student">
                            Student
                        </option>

                    </select>

                </div>

            </div>


            <!-- Table -->

            <div class="table-wrapper">

                <table class="user-table"
                       id="userTable">

                    <thead>

                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Gender</th>
                            <th>Position</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr>

                                    <td class="user-id">
                                        @user.UserId
                                    </td>


                                    <td class="username">
                                        @user.Username
                                    </td>


                                    <td class="email">
                                        @user.Email
                                    </td>


                                    <td>
                                        @user.Phone
                                    </td>


                                    <td>
                                        @user.Gender
                                    </td>


                                    <td class="position">
                                        @user.Position
                                    </td>


                                    <td>

                                        @if (user.Status == "Active")
                                        {
                                            <span class="status status-active">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status status-inactive">
                                                Inactive
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <div class="actions">

                                            @* Admin has no action buttons *@

                                            @if (user.Position != "Admin")
                                            {
                                                @if (user.Status == "Active")
                                                {
                                                    <form asp-controller="User"
                                                          asp-action="Delete"
                                                          asp-route-id="@user.UserId"
                                                          method="post"
                                                          class="action-form">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="action-button deactivate-button"
                                                                onclick="return confirm('Are you sure you want to block this user?');">
                                                            Block
                                                        </button>

                                                    </form>
                                                }
                                                else
                                                {
                                                    <form asp-controller="User"
                                                          asp-action="Activate"
                                                          asp-route-id="@user.UserId"
                                                          method="post"
                                                          class="action-form">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="action-button activate-button">
                                                            Activate
                                                        </button>

                                                    </form>
                                                }
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="empty-message">

                                    No users found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- Search and Role Filter -->

<script>

    const searchInput =
        document.getElementById("userSearch");

    const roleFilter =
        document.getElementById("roleFilter");

    const tableRows =
        document.querySelectorAll("#userTable tbody tr");


    function filterUsers() {

        const searchText =
            searchInput.value.toLowerCase().trim();

        const selectedRole =
            roleFilter.value;


        tableRows.forEach(row => {

            const username =
                row.cells[1]?.textContent
                    .toLowerCase()
                    .trim() || "";

            const email =
                row.cells[2]?.textContent
                    .toLowerCase()
                    .trim() || "";

            const phone =
                row.cells[3]?.textContent
                    .toLowerCase()
                    .trim() || "";

            const role =
                row.cells[5]?.textContent
                    .trim() || "";


            const matchesSearch =
                username.includes(searchText) ||
                email.includes(searchText) ||
                phone.includes(searchText);


            const matchesRole =
                selectedRole === "all" ||
                role === selectedRole;


            if (matchesSearch && matchesRole) {

                row.style.display = "";

            }
            else {

                row.style.display = "none";

            }

        });

    }


    searchInput.addEventListener(
        "input",
        filterUsers
    );


    roleFilter.addEventListener(
        "change",
        filterUsers
    );

</script>
```
