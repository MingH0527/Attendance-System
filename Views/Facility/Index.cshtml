@model List<WebAndMobile.Models.Facility>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Facility Booking";
}
@section Styles {
    <link rel="stylesheet" href="~/css/facility.css" asp-append-version="true" />
}
<div class="facility-page">
    <a asp-controller="Student" asp-action="Index" class="facility-back">← Back</a>

    <div class="facility-header">
        <div>
            <span class="facility-kicker">ACTIVITY ATTENDANCE</span>
            <h1>Facility Booking</h1>
            <p>Choose a 24-hour self-service facility and reserve an available time.</p>
        </div>
    </div>

    <nav class="facility-section-nav student-nav" aria-label="Facility booking navigation">
        <a asp-action="Index" class="active">Facilities</a>
        <a asp-action="MyBookings">My Bookings</a>
    </nav>

    @if (TempData["FacilityError"] != null) { <div class="facility-alert error">@TempData["FacilityError"]</div> }
    @if (TempData["FacilitySuccess"] != null) { <div class="facility-alert success">@TempData["FacilitySuccess"]</div> }

    @{ int activeBookingCount = ViewBag.ActiveBookingCount is int count ? count : 0; }
    <section class="booking-limit-card @(activeBookingCount >= 2 ? "reached" : "")">
        <div>
            <span class="facility-kicker">@(activeBookingCount >= 2 ? "BOOKING LIMIT REACHED" : "FACILITY BOOKING LIMIT")</span>
            <h2>@activeBookingCount / 2 Active Bookings</h2>
            @if (activeBookingCount >= 2)
            {
                <p>You currently have 2 active facility bookings.<br/>Complete or cancel an existing booking before making another booking.</p>
            }
            else
            {
                <p>You can have a maximum of 2 active facility bookings at a time.<br/>Pending, Approved and ongoing Checked-In bookings count toward the limit.<br/>Cancelled and completed bookings do not count.</p>
            }
        </div>
    </section>

    <div class="facility-grid five-cards">
        @foreach (var facility in Model)
        {
            var cover = facility.Images.FirstOrDefault(i => i.IsCover) ?? facility.Images.FirstOrDefault();
            <article class="facility-card">
                <div class="facility-card-image">
                    @if (cover != null) { <img src="@cover.ImagePath" alt="@facility.FacilityName" /> }
                    else { <div class="facility-placeholder">🏫</div> }
                    <span class="facility-badge">24 Hours</span>
                </div>
                <div class="facility-card-body">
                    <h2>@facility.FacilityName</h2>
                    <p class="facility-location">📍 @facility.Location</p>
                    <p>@facility.Description</p>
                    @if (activeBookingCount >= 2)
                    {
                        <span class="facility-primary-btn disabled" aria-disabled="true">Book Facility</span>
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@facility.FacilityId" class="facility-primary-btn">View &amp; Book</a>
                    }
                </div>
            </article>
        }
    </div>
</div>
