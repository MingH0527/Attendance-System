@model WebAndMobile.Models.FacilityBooking
@{ Layout = "_Layout"; ViewData["Title"] = "Activity Check-In QR"; }
@section Styles { <link rel="stylesheet" href="~/css/facility.css" asp-append-version="true" /> }
<div class="facility-page narrow qr-page">
    <a asp-action="BookingRequests" class="facility-back">← Back to Booking Requests</a>
    <nav class="facility-section-nav" aria-label="Facility management navigation"><a asp-action="AdminIndex">Facilities</a><a asp-action="BookingRequests" class="active">Booking Requests</a><a asp-action="ActivityAttendance">Activity Attendance</a></nav>
    <section class="qr-card">
        <span class="facility-kicker">ACTIVITY ATTENDANCE</span><h1>Activity Check-In QR</h1><p class="qr-facility">@Model.Facility?.FacilityName</p>
        <div class="qr-meta"><span><strong>Booking</strong>@Model.BookingId</span><span><strong>Date</strong>@Model.BookingDate.ToString("dd MMM yyyy")</span><span><strong>Time</strong>@($"{Model.StartHour:00}:00")–@(Model.EndHour == 24 ? "00:00" : $"{Model.EndHour:00}:00")</span></div>
        <div class="qr-image"><img src="@ViewBag.QrDataUrl" alt="Activity Check-In QR" /></div>
        <p class="qr-instruction">Student scans this QR on a phone, enters Student ID and login password, then completes Face ID verification.</p>
        <span class="status-pill status-@Model.Status.Replace(" ", "").ToLowerInvariant()">@Model.Status</span>
    </section>
</div>
