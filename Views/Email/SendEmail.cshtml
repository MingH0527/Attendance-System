@model WebAndMobile.Models.EmailModel

<h2>Send Email</h2>

@if (ViewBag.Message != null)
{
    <div style="color:green;font-weight:bold">@ViewBag.Message</div>
}

@if (ViewBag.Error != null)
{
    <div style="color:red;font-weight:bold">@ViewBag.Error</div>
}

<form asp-controller="Home" asp-action="SendEmail" method="post">
    <div asp-validation-summary="All" style="color:red"></div>

    <input name="Email" value="@Model.Email" />
    <br /><br />

    <textarea name="Message" rows="5">@Model.Message</textarea>
    <br /><br />

    <button type="submit">Send</button>
</form>