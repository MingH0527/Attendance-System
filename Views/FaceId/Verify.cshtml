@{
    ViewData["Title"] = "Verify Payment Face ID";
    int? feeId = ViewBag.FeeId;
    string returnUrl = ViewBag.ReturnUrl ?? Url.Action("SelectFee", "Payment")!;
}
<link rel="stylesheet" href="~/css/face-payment.css" asp-append-version="true" />
<div class="security-shell">
    <section class="security-card camera-card" id="faceApp"
             data-mode="verify"
             data-auto-start="true"
             data-return-url="@returnUrl">
        @Html.AntiForgeryToken()
        <p class="eyebrow">AI Identity Verification</p>
        <h1>Verifying your face</h1>
        <p class="muted">The camera starts automatically. The QR code remains locked until the registered user is confirmed.</p>
        <div class="camera-frame">
            <video id="faceVideo" autoplay playsinline muted></video>
            <canvas id="captureCanvas" hidden></canvas>
            <div class="face-guide"></div>
        </div>
        <div class="progress-caption"><span>Verification progress</span><strong id="progressText">0%</strong></div>
        <div class="progress-track"><div id="faceProgress" class="progress-value"></div></div>
        <div id="faceStatus" class="face-status">Requesting camera permission…</div>
        <button id="startFaceButton" class="primary-action button-action" type="button">Restart Verification</button>
        <a class="secondary-action" asp-controller="Payment" asp-action="Pay" asp-route-feeId="@feeId">Cancel</a>
    </section>
</div>
<script src="~/js/face-payment.js" asp-append-version="true"></script>
