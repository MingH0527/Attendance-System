@model WebAndMobile.Models.TeacherManageAttendanceViewModel

@{
    ViewData["Title"] = "Manage Attendance";
}

<link rel="stylesheet"
      href="~/css/teacherhome.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/teacher-manage-attendance.css"
      asp-append-version="true" />


<div class="teacher-dashboard">

    <header class="teacher-header">

        <div>

            <a asp-controller="Teacher"
               asp-action="AttendanceCode"
               class="attendance-back">
                ← Back to Attendance Code
            </a>

            <p class="teacher-role">
                Teacher Portal
            </p>

            <h1>
                Student Attendance
            </h1>

            <p>
                @Model.CourseName
                ·
                @Model.ClassName
            </p>

        </div>


        <div class="manage-lesson-summary">

            <strong>
                @Model.Date.ToString("dd MMM yyyy")
            </strong>

            <span>
                @Model.StartTime.ToString(@"hh\:mm")
                -
                @Model.EndTime.ToString(@"hh\:mm")
            </span>

            <span>
                @Model.RoomName
            </span>

        </div>

    </header>


    @if (TempData["AttendanceError"] != null)
    {
        <div class="attendance-message error">
            ⚠ @TempData["AttendanceError"]
        </div>
    }


    @if (TempData["AttendanceSuccess"] != null)
    {
        <div class="attendance-message success">
            ✓ @TempData["AttendanceSuccess"]
        </div>
    }


    @if (!Model.HasGeneratedCode)
    {
        <div class="manual-attendance-alert">

            <div class="manual-attendance-alert-icon">
                ⚠
            </div>

            <div>

                <strong>
                    Attendance code was not generated
                </strong>

                <p>
                    Please complete the attendance manually
                    by checking every student's status.
                </p>

            </div>

        </div>
    }


    <section class="manage-attendance-card">

        <div class="manage-attendance-heading">

            <div>

                <h2>
                    Student Attendance
                </h2>


                <p>
                    @if (!Model.HasGeneratedCode)
                    {
                        <text>
                            Manual attendance is required for this class.
                        </text>
                    }
                    else if (Model.ClassEnded)
                    {
                        <text>
                            Students without a valid Present record
                            or approved leave are counted as Absent.
                        </text>
                    }
                    else
                    {
                        <text>
                            You may review and correct student attendance.
                        </text>
                    }
                </p>

            </div>


            <span class="attendance-count">
                @Model.Students.Count
            </span>

        </div>


        @if (Model.Students.Count == 0)
        {
            <div class="manage-attendance-empty">

                No students are registered in this class.

            </div>
        }
        else
        {
            <div class="manage-attendance-table-wrap">

                <table class="manage-attendance-table">

                    <thead>

                        <tr>

                            <th>
                                Student ID
                            </th>

                            <th>
                                Username
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Description
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var student in Model.Students)
                        {
                            string statusClass =
                                student.Status
                                    .ToLowerInvariant()
                                    .Replace(" ", "-");


                            <tr>


                                <td>
                                    @student.StudentId
                                </td>


                                <td>
                                    @student.Username
                                </td>


                                <td>

                                    <span class="attendance-status @statusClass">

                                        @student.Status

                                    </span>

                                </td>


                                <td>

                                    @(string.IsNullOrWhiteSpace(student.Description)
                                        ? "-"
                                        : student.Description)

                                </td>


                                <td>

                                    @if (!student.CanEdit)
                                    {
                                        <span class="attendance-locked">

                                            🔒 Approved Leave

                                        </span>
                                    }
                                    else
                                    {
                                        <div class="attendance-row-actions">


                                            @if (student.Status != "Present")
                                            {
                                                <form asp-controller="Attendance"
                                                      asp-action="MarkPresent"
                                                      method="post">

                                                    @Html.AntiForgeryToken()


                                                    <input type="hidden"
                                                           name="timetableId"
                                                           value="@Model.TimetableId" />


                                                    <input type="hidden"
                                                           name="date"
                                                           value="@Model.Date.ToString("yyyy-MM-dd")" />


                                                    <input type="hidden"
                                                           name="studentClassId"
                                                           value="@student.StudentClassId" />


                                                    @if (!string.IsNullOrWhiteSpace(Model.ReplacementId))
                                                    {
                                                        <input type="hidden"
                                                               name="replacementId"
                                                               value="@Model.ReplacementId" />
                                                    }


                                                    <button type="submit"
                                                            class="mark-present-button">

                                                        ✓ Mark Present

                                                    </button>

                                                </form>
                                            }


                                            @if (student.Status == "Present")
                                            {
                                                <form asp-controller="Attendance"
                                                      asp-action="MarkAbsent"
                                                      method="post">

                                                    @Html.AntiForgeryToken()


                                                    <input type="hidden"
                                                           name="timetableId"
                                                           value="@Model.TimetableId" />


                                                    <input type="hidden"
                                                           name="date"
                                                           value="@Model.Date.ToString("yyyy-MM-dd")" />


                                                    <input type="hidden"
                                                           name="studentClassId"
                                                           value="@student.StudentClassId" />


                                                    @if (!string.IsNullOrWhiteSpace(Model.ReplacementId))
                                                    {
                                                        <input type="hidden"
                                                               name="replacementId"
                                                               value="@Model.ReplacementId" />
                                                    }


                                                    <button type="submit"
                                                            class="mark-absent-button">

                                                        ✕ Mark Absent

                                                    </button>

                                                </form>
                                            }


                                        </div>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>