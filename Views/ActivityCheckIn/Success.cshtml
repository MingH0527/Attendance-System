@model WebAndMobile.Models.FacilityBooking
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Activity Check-In Successful"; }
<link rel="stylesheet" href="~/css/activity-checkin.css" asp-append-version="true" />
<div class="activity-mobile-shell"><section class="activity-mobile-card success-card"><div class="activity-success-mark">✓</div><span class="activity-eyebrow">ACTIVITY ATTENDANCE</span><h1>Check-In Successful</h1><p class="activity-facility">@Model.Facility?.FacilityName</p><div class="activity-result-grid"><span><small>Booking ID</small><strong>@Model.BookingId</strong></span><span><small>Student</small><strong>@Model.StudentId</strong></span><span><small>Date</small><strong>@Model.BookingDate.ToString("dd MMM yyyy")</strong></span><span><small>Booking Time</small><strong>@($"{Model.StartHour:00}:00")–@(Model.EndHour == 24 ? "00:00" : $"{Model.EndHour:00}:00")</strong></span><span><small>Check-In Time</small><strong>@Model.Attendance?.CheckInTime.ToString("HH:mm")</strong></span><span><small>Verification</small><strong>QR + Face ID ✓</strong></span></div><div class="present-box"><small>ACTIVITY ATTENDANCE</small><strong>PRESENT</strong></div></section></div>
