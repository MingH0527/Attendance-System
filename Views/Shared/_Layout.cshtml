@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using WebAndMobile.Models

@inject DB LayoutDb

@{
    string? currentRole =
        User.FindFirstValue(ClaimTypes.Role);

    bool isStudent =
        string.Equals(
            currentRole,
            "Student",
            StringComparison.OrdinalIgnoreCase);

    bool isAdmin =
        string.Equals(
            currentRole,
            "Admin",
            StringComparison.OrdinalIgnoreCase);

    bool showChrome = isStudent || isAdmin;

    // Language is a student-portal feature only. Read the saved
    // preference so a returning student sees their own choice.
    string currentLanguage = "en";

    if (isStudent)
    {
        string? layoutUserId =
            User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(layoutUserId))
        {
            string? saved =
                await LayoutDb.Users
                    .AsNoTracking()
                    .Where(u => u.UserId == layoutUserId)
                    .Select(u => u.PreferredLanguage)
                    .FirstOrDefaultAsync();

            if (!string.IsNullOrWhiteSpace(saved))
            {
                currentLanguage = saved;
            }
        }
    }
}

<!DOCTYPE html>

<html lang="@currentLanguage">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Attendance System</title>

    <link rel="stylesheet"
          href="~/css/app.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <div class="layout @(showChrome ? "" : "layout--no-chrome")">

        @if (showChrome)
        {
            <header class="topbar">

                <div class="logo">

                    <img src="~/image/Logo_transparent_bg.png" alt="Logo" />

                </div>

                <div class="top-actions">

                    <form asp-controller="@(isStudent ? "Student" : "Account")"
                          asp-action="Logout"
                          method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit">
                            Logout
                        </button>
                    </form>

                    @* Student portal only: admins get the Logout button alone. *@
                    @if (isStudent)
                    {
                        <div class="profile-dropdown">

                            <button type="button"
                                    id="profileDropdownToggle"
                                    class="profile-dropdown-toggle">

                                My Profile

                            </button>

                            <div class="profile-dropdown-menu"
                                 id="profileDropdownMenu">

                                <div class="dropdown-item">
                                    <span>Dark Mode</span>
                                    <label class="switch">
                                        <input type="checkbox" id="darkModeToggle" />
                                        <span class="slider"></span>
                                    </label>
                                </div>

                                <div class="dropdown-item">
                                    <span>Language</span>

                                    @* Option labels are already in their own
                                       language - never send them for translation. *@
                                    <select id="languageSelect" data-no-translate>
                                        <option value="en">English</option>
                                        <option value="zh">中文</option>
                                        <option value="ms">Bahasa Melayu</option>
                                    </select>
                                </div>

                            </div>

                        </div>
                    }

                </div>

            </header>

            <aside class="sidebar">

                @if (isAdmin)
                {
                    <a asp-controller="Admin"
                       asp-action="Index">

                        Home

                    </a>

                    <a asp-controller="Admin"
                       asp-action="Dashboard">

                        Dashboard

                    </a>

                    <a asp-controller="MyProfile"
                       asp-action="Index">

                        My Profile

                    </a>

                    <a asp-controller="MyProfile"
                       asp-action="Passkey">

                        Passkey &amp; PIN

                    </a>

                    <a asp-controller="Admin"
                       asp-action="Timetable">

                        Timetable

                    </a>

                    <a asp-controller="ProgramSubject"
                       asp-action="Index">

                        Program &amp; Subject

                    </a>

                    <a asp-controller="User"
                       asp-action="Index">

                        User Management

                    </a>

                    <a asp-controller="Admin"
                       asp-action="LeaveManagement">

                        Leave Management

                    </a>

                    <a asp-controller="Admin"
                        asp-action="BarredList">

                        Barred List
                    
                    </a>
                }
                else
                {
                    <a asp-controller="Student"
                       asp-action="Index">

                        Home

                    </a>

                    <a asp-controller="MyProfile"
                       asp-action="Index">

                        My Profile

                    </a>

                    <a asp-controller="Student"
                       asp-action="Timetable">

                        Timetable

                    </a>

                    <a asp-controller="Student"
                        asp-action="Attendance">
                    
                        Attendance

                    </a>
                      

                    <a asp-controller="Student"
                       asp-action="ApplyLeave">

                        Apply Leave

                    </a>

                    
                    <a asp-controller="Chat"
                       asp-action="Index">

                        Chat

                    </a>

                    @* Payment and Payment History are one entry; the two
                       views share a tab bar once you are inside. *@
                    <a asp-controller="Payment"
                       asp-action="SelectFee">

                        Payment

                    </a>
                }
            </aside>
        }

        <main class="content">

            @RenderBody()

        </main>

    </div>

    <script>
            (function () {
                var toggle = document.getElementById('profileDropdownToggle');
                var menu = document.getElementById('profileDropdownMenu');

                if (!toggle || !menu) return;

                toggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    menu.classList.toggle('show');
                });

                document.addEventListener('click', function (e) {
                    if (!menu.contains(e.target) && e.target !== toggle) {
                        menu.classList.remove('show');
                    }
                });
            })();
    </script>

    @if (isStudent)
    {
        @* Token source for the language fetch calls. *@
        <form id="languageTokenForm"
              data-no-translate
              style="display:none">
            @Html.AntiForgeryToken()
        </form>

        <script data-no-translate>
            window.appTranslation = {
                current: '@currentLanguage',
                setUrl: '@Url.Action("Set", "Language")',
                translateUrl: '@Url.Action("Translate", "Language")'
            };
        </script>

        <script src="~/js/translate.js"
                asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>