@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using WebAndMobile.Models

@inject DB AuthLayoutDb

@{
    // Pages such as Program/RegisterProgram use this bare layout, but a
    // signed-in student should still see them in their chosen language.
    //
    // Login, Register, OTP and the landing page also use this layout. An
    // auth cookie can outlive the browser session, so a student who closes
    // the browser and reopens on /Account/Login is still "signed in" as far
    // as this check is concerned - which used to apply their dark theme and
    // language to the sign-in screen. Those pages are shown to every role
    // and to visitors with no account, so they stay on the light theme.
    string authController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    bool isPreLoginPage =
        string.Equals(authController, "Account",
            StringComparison.OrdinalIgnoreCase) ||
        string.Equals(authController, "Home",
            StringComparison.OrdinalIgnoreCase);

    bool authIsStudent =
        !isPreLoginPage &&
        string.Equals(
            User.FindFirstValue(ClaimTypes.Role),
            "Student",
            StringComparison.OrdinalIgnoreCase);

    string authLanguage = "en";

    if (authIsStudent)
    {
        string? authUserId =
            User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(authUserId))
        {
            string? authSaved =
                await AuthLayoutDb.Users
                    .AsNoTracking()
                    .Where(u => u.UserId == authUserId)
                    .Select(u => u.PreferredLanguage)
                    .FirstOrDefaultAsync();

            if (!string.IsNullOrWhiteSpace(authSaved))
            {
                authLanguage = authSaved;
            }
        }
    }
}

<!DOCTYPE html>
<html lang="@authLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Attendance System</title>

    <link rel="stylesheet"
          href="~/css/app.css"
          asp-append-version="true" />

@if (authIsStudent)
{
        @* Dark mode follows the student across the bare-shell pages too
           (payment, register program, receipts). *@
        <link rel="stylesheet"
              href="~/css/dark.css"
              asp-append-version="true" />

        <script data-no-translate>
            (function () {
                try {
                    if (localStorage.getItem('darkMode') === 'on') {
                        document.documentElement.classList.add('dark');
                    }
                } catch (e) { }
            })();
        </script>
}

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    @RenderBody()

    @if (authIsStudent)
    {
        @* Token source for the language fetch calls. *@
        <form id="languageTokenForm"
              data-no-translate
              style="display:none">
            @Html.AntiForgeryToken()
        </form>

        <script data-no-translate>
            window.appTranslation = {
                current: '@authLanguage',
                setUrl: '@Url.Action("Set", "Language")',
                translateUrl: '@Url.Action("Translate", "Language")'
            };
        </script>

        <script src="~/js/translate.js"
                asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>