@model WebAndMobile.Models.ProgramRegisterViewModel

@{
    ViewData["Title"] = "Class / Course Registration";
}

<link rel="stylesheet" href="~/css/Program.css" />

<div class="program-page">
    <div class="program-container">

        <span class="eyebrow">My Profile</span>
        <h1>@(Model.Position == "Teacher" ? "Course Registration" : "Class Registration")</h1>
        <p class="subtitle">
            @if (Model.Position == "Teacher")
            {
                <span>Select the course(s) you teach.</span>
            }
            else
            {
                <span>Select the class you belong to.</span>
            }
        </p>

        @if (!string.IsNullOrEmpty(Model.CurrentClassName) || Model.CurrentCourseNames.Any())
        {
            <div class="current-registration">
                <span class="current-registration__label">Currently registered</span>

                @if (Model.Position == "Student" && Model.CurrentClassName != null)
                {
                    @if (!string.IsNullOrEmpty(Model.CurrentStudentId))
                    {
                        <span class="current-registration__tag">Student ID: @Model.CurrentStudentId</span>
                    }
                    <span class="current-registration__value">@Model.CurrentProgramName</span>
                    <span class="current-registration__tag">@Model.CurrentClassName</span>
                }

                @if (Model.Position == "Teacher" && Model.CurrentCourseNames.Any())
                {
                    <div class="current-registration__courses">
                        @foreach (var c in Model.CurrentCourseNames)
                        {
                            <span class="current-registration__tag">@c</span>
                        }
                    </div>
                }
            </div>
        }

        <form asp-action="RegisterProgram" method="post" class="program-form">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input type="hidden" asp-for="Position" />

            @if (Model.Position == "Teacher")
            {
                <div class="form-group">
                    <label>Course(s) you teach</label>
                    <div class="course-checkboxes">
                        @foreach (var c in Model.AvailableCourses)
                        {
                            <label class="course-option">
                                <input type="checkbox" name="SelectedCourseIds" value="@c.CourseId"
                                       checked="@(Model.SelectedCourseIds.Contains(c.CourseId))" />
                                <span>
                                    @c.CourseName
                                    @if (!string.IsNullOrEmpty(c.CourseCode))
                                    {
                                        <small>(@c.CourseCode)</small>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="SelectedCourseIds" class="field-error"></span>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label asp-for="SelectedProgramId">Program</label>
                    <select asp-for="SelectedProgramId" id="programSelect" onchange="filterClassesByProgram()">
                        <option value="">-- Choose a program --</option>
                        @foreach (var p in Model.AvailablePrograms)
                        {
                            <option value="@p.ProgramId">@p.ProgramName (@p.ProgramCode)</option>
                        }
                    </select>
                    <span asp-validation-for="SelectedProgramId" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SelectedClassId">Class</label>
                    <select asp-for="SelectedClassId" id="classSelect">
                        <option value="">-- Choose your program first --</option>
                        @foreach (var c in Model.AvailableClasses)
                        {
                            <option value="@c.ClassId" data-program="@c.ProgramId">@c.ClassName</option>
                        }
                    </select>
                    <span asp-validation-for="SelectedClassId" class="field-error"></span>
                </div>
            }

            <button type="submit" class="save-button">Save Registration</button>

            <a asp-controller="MyProfile" asp-action="Index" class="back-link">← Back to My Profile</a>

        </form>
    </div>
</div>

<script>

    function filterClassesByProgram() {
        var programId = document.getElementById('programSelect').value;
        var classSelect = document.getElementById('classSelect');
        if (!classSelect) return;

        Array.from(classSelect.options).forEach(function(opt) {
            if (!opt.dataset.program) return; // 占位选项跳过
            opt.hidden = programId !== '' && opt.dataset.program !== programId;
        });
        classSelect.value = '';
    }

    document.addEventListener('DOMContentLoaded', filterClassesByProgram);
</script>
